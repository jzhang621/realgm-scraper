          "text": "1\t\"\"\"\n2\tFastAPI Backend for NCAA Basketball Stats\n3\t\"\"\"\n4\tfrom fastapi import FastAPI, HTTPException, Query, Request\n5\tfrom fastapi.middleware.cors import CORSMiddleware\n6\tfrom fastapi.middleware.gzip import GZipMiddleware\n7\tfrom fastapi.responses import JSONResponse\n8\tfrom fastapi.staticfiles import StaticFiles\n9\tfrom typing import List, Optional\n10\tfrom pydantic import BaseModel\n11\tfrom sqlalchemy import create_engine, text\n12\tfrom sqlalchemy.pool import QueuePool\n13\timport os\n14\timport time\n15\timport psycopg2\n16\timport psycopg2.extras\n17\tfrom decimal import Decimal\n18\tfrom datetime import datetime, date\n19\t\n20\t# Database connection\n21\tDATABASE_URL = os.getenv('DATABASE_URL', 'postgresql://localhost:5432/ncaa_basketball')\n22\tengine = create_engine(\n23\t    DATABASE_URL,\n24\t    poolclass=QueuePool,\n25\t    pool_size=5,\n26\t    max_overflow=10\n27\t)\n28\t\n29\tapp = FastAPI(\n30\t    title=\"NCAA Basketball Stats API\",\n31\t    description=\"API for NCAA D1 Basketball player statistics and ratings\",\n32\t    version=\"1.0.0\"\n33\t)\n34\t\n35\t# CORS middleware\n36\tapp.add_middleware(\n37\t    CORSMiddleware,\n38\t    allow_origins=[\"*\"],  # In production, replace with specific domains\n39\t    allow_credentials=True,\n40\t    allow_methods=[\"*\"],\n41\t    allow_headers=[\"*\"],\n42\t)\n43\t\n44\t# Gzip compression — compresses large JSON responses ~70%\n45\tapp.add_middleware(GZipMiddleware, minimum_size=1000)\n46\t\n47\t# Helper function to convert rows to dict, normalizing Decimal/date types inline\n48\tdef rows_to_dict(rows, result):\n49\t    \"\"\"Convert database rows to list of dicts with JSON-safe types\"\"\"\n50\t    columns = list(result.keys())\n51\t    out = []\n52\t    for row in rows:\n53\t        d = {}\n54\t        for k, v in zip(columns, row):\n55\t            if isinstance(v, Decimal):\n56\t                d[k] = float(v)\n57\t            elif isinstance(v, (datetime, date)):\n58\t                d[k] = v.isoformat()\n59\t            else:\n60\t                d[k] = v\n61\t        out.append(d)\n62\t    return out\n63\t\n64\t\n65\t@app.get(\"/api/ratings/{season}\")\n66\tdef get_ratings(\n67\t    season: str,\n68\t    position: Optional[str] = None,\n69\t    team: Optional[str] = None,\n70\t    min_rating: Optional[float] = None,\n71\t    two_way: Optional[str] = None,\n72\t    limit: int = Query(100, le=15000),\n73\t    offset: int = 0\n74\t):\n75\t    \"\"\"\n76\t    Get player ratings for a season with optional filters\n77\t\n78\t    - **season**: \"2024-25\" or \"2025-26\"\n79\t    - **position**: Filter by position\n80\t    - **team**: Filter by team\n81\t    - **min_rating**: Minimum rating threshold\n82\t    - **two_way**: \"Y\" for two-way players only\n83\t    - **limit**: Max results (default 100, max 500)\n84\t    - **offset**: Pagination offset\n85\t    \"\"\"\n86\t    with engine.connect() as conn:\n87\t        query = \"\"\"\n88\t            SELECT *\n89\t            FROM player_ratings\n90\t            WHERE season = :season\n91\t        \"\"\"\n92\t        params = {'season': season}\n93\t\n94\t        if position:\n95\t            query += \" AND position = :position\"\n96\t            params['position'] = position\n97\t\n98\t        if team:\n99\t            query += \" AND team = :team\"\n100\t            params['team'] = team\n101\t\n102\t        if min_rating:\n103\t            query += \" AND final_rating >= :min_rating\"\n104\t            params['min_rating'] = min_rating\n105\t\n106\t        if two_way == 'Y':\n107\t            query += \" AND two_way = 'Y'\"\n108\t\n109\t        query += \" ORDER BY final_rating DESC LIMIT :limit OFFSET :offset\"\n110\t        params['limit'] = limit\n111\t        params['offset'] = offset\n112\t\n113\t        result = conn.execute(text(query), params)\n114\t        rows = result.fetchall()\n115\t\n116\t        data = rows_to_dict(rows, result)\n117\t\n118\t        return {\n119\t            \"season\": season,\n120\t            \"count\": len(data),\n121\t            \"data\": data\n122\t        }\n123\t\n124\t@app.get(\"/api/player/{player_id}\")\n125\tdef get_player(player_id: str):\n126\t    \"\"\"Get complete player information\"\"\"\n127\t    with engine.connect() as conn:\n128\t        # Get player bio\n129\t        result = conn.execute(\n130\t            text(\"SELECT * FROM players WHERE player_id = :player_id\"),\n131\t            {'player_id': player_id}\n132\t        )\n133\t        player = result.fetchone()\n134\t\n135\t        if not player:\n136\t            raise HTTPException(status_code=404, detail=\"Player not found\")\n137\t\n138\t        player_dict = dict(zip(result.keys(), player))\n139\t\n140\t        # Get all ratings\n141\t        result = conn.execute(\n142\t            text(\"\"\"\n143\t                SELECT * FROM player_ratings\n144\t                WHERE player_id = :player_id\n145\t                ORDER BY season DESC\n146\t            \"\"\"),\n147\t            {'player_id': player_id}\n148\t        )\n149\t        ratings = rows_to_dict(result.fetchall(), result)\n150\t\n151\t        return {\"player\": player_dict, \"ratings\": ratings}\n152\t\n153\t@app.get(\"/api/stats/{player_id}/{season}\")\n154\tdef get_player_stats(player_id: str, season: str):\n155\t    \"\"\"Get all stats for a player in a specific season\"\"\"\n156\t    with engine.connect() as conn:\n157\t        # Per game stats\n158\t        result = conn.execute(\n159\t            text(\"\"\"\n160\t                SELECT * FROM player_stats_pergame\n161\t                WHERE player_id = :player_id AND season = :season\n162\t            \"\"\"),\n163\t            {'player_id': player_id, 'season': season}\n164\t        )\n165\t        pergame = rows_to_dict(result.fetchall(), result)\n166\t\n167\t        # Advanced stats\n168\t        result = conn.execute(\n169\t            text(\"\"\"\n170\t                SELECT * FROM player_stats_advanced\n171\t                WHERE player_id = :player_id AND season = :season\n172\t            \"\"\"),\n173\t            {'player_id': player_id, 'season': season}\n174\t        )\n175\t        advanced = rows_to_dict(result.fetchall(), result)\n176\t\n177\t        # Misc stats\n178\t        result = conn.execute(\n179\t            text(\"\"\"\n180\t                SELECT * FROM player_stats_misc\n181\t                WHERE player_id = :player_id AND season = :season\n182\t            \"\"\"),\n183\t            {'player_id': player_id, 'season': season}\n184\t        )\n185\t        misc = rows_to_dict(result.fetchall(), result)\n186\t\n187\t        # Rating\n188\t        result = conn.execute(\n189\t            text(\"\"\"\n190\t                SELECT * FROM player_ratings\n191\t                WHERE player_id = :player_id AND season = :season\n192\t            \"\"\"),\n193\t            {'player_id': player_id, 'season': season}\n194\t        )\n195\t        rating = rows_to_dict(result.fetchall(), result)\n196\t\n197\t        if not pergame and not rating:\n198\t            raise HTTPException(status_code=404, detail=\"Stats not found for this player/season\")\n199\t\n200\t        return {\n201\t            \"player_id\": player_id,\n202\t            \"season\": season,\n203\t            \"pergame\": pergame[0] if pergame else None,\n204\t            \"advanced\": advanced[0] if advanced else None,\n205\t            \"misc\": misc[0] if misc else None,\n206\t            \"rating\": rating[0] if rating else None\n207\t        }\n208\t\n209\t@app.get(\"/api/search\")\n210\tdef search_players(\n211\t    q: str = Query(..., min_length=2),\n212\t    season: Optional[str] = None,\n213\t    limit: int = 20\n214\t):\n215\t    \"\"\"\n216\t    Search players by name\n217\t\n218\t    - **q**: Search query (min 2 characters)\n219\t    - **season**: Optional season filter\n220\t    - **limit**: Max results (default 20)\n221\t    \"\"\"\n222\t    with engine.connect() as conn:\n223\t        if season:\n224\t            query = \"\"\"\n225\t                SELECT DISTINCT\n226\t                    p.player_id,\n227\t                    p.full_name,\n228\t                    pr.team,\n229\t                    pr.position,\n230\t                    pr.final_rating\n231\t                FROM players p\n232\t                JOIN player_ratings pr ON p.player_id = pr.player_id\n233\t                WHERE LOWER(p.full_name) LIKE LOWER(:query)\n234\t                  AND pr.season = :season\n235\t                ORDER BY pr.final_rating DESC\n236\t                LIMIT :limit\n237\t            \"\"\"\n238\t            params = {'query': f'%{q}%', 'season': season, 'limit': limit}\n239\t        else:\n240\t            query = \"\"\"\n241\t                SELECT player_id, full_name, position\n242\t                FROM players\n243\t                WHERE LOWER(full_name) LIKE LOWER(:query)\n244\t                LIMIT :limit\n245\t            \"\"\"\n246\t            params = {'query': f'%{q}%', 'limit': limit}\n247\t\n248\t        result = conn.execute(text(query), params)\n249\t        rows = result.fetchall()\n250\t\n251\t        data = rows_to_dict(rows, result)\n252\t\n253\t        return {\"query\": q, \"count\": len(data), \"results\": data}\n254\t\n255\t@app.get(\"/api/compare\")\n256\tdef compare_players(\n257\t    player1: str,\n258\t    player2: str,\n259\t    season: str\n260\t):\n261\t    \"\"\"Compare two players for a specific season\"\"\"\n262\t    with engine.connect() as conn:\n263\t        query = text(\"\"\"\n264\t            SELECT *\n265\t            FROM player_ratings\n266\t            WHERE player_id IN (:p1, :p2) AND season = :season\n267\t        \"\"\")\n268\t\n269\t        result = conn.execute(query, {'p1': player1, 'p2': player2, 'season': season})\n270\t        ratings = rows_to_dict(result.fetchall(), result)\n271\t\n272\t        if len(ratings) < 2:\n273\t            raise HTTPException(\n274\t                status_code=404,\n275\t                detail=\"Could not find both players for this season\"\n276\t            )\n277\t\n278\t        return {\"season\": season, \"players\": ratings}\n279\t\n280\t@app.get(\"/api/teams/{season}\")\n281\tdef get_teams(season: str):\n282\t    \"\"\"Get all teams for a season\"\"\"\n283\t    with engine.connect() as conn:\n284\t        result = conn.execute(\n285\t            text(\"\"\"\n286\t                SELECT team_name, conference, wins, losses, total_games\n287\t                FROM teams\n288\t                WHERE season = :season\n289\t                ORDER BY conference, team_name\n290\t            \"\"\"),\n291\t            {'season': season}\n292\t        )\n293\t        teams = rows_to_dict(result.fetchall(), result)\n294\t\n295\t        return {\n296\t            \"season\": season,\n297\t            \"count\": len(teams),\n298\t            \"teams\": teams\n299\t        }\n300\t\n301\tALLOWED_SORT_COLS = {\n302\t    'final_rating', 'full_name', 'team', 'position', 'age', 'height_in', 'weight', 'gp',\n303\t    'min', 'pts', 'reb', 'ast', 'stl', 'blk', 'tov',\n304\t    'fg_pct', 'fg3m', 'fg3a', 'fg3_pct', 'ft_pct', 'fgm', 'fga', 'ftm', 'fta',\n305\t    'off_reb', 'def_reb', 'ts_pct', 'efg_pct', 'orb_pct', 'drb_pct',\n306\t    'ast_pct', 'tov_pct', 'stl_pct', 'blk_pct', 'usg_pct', 'per', 'ortg', 'drtg',\n307\t    'ppr', 'pps', 'dbl_dbl', 'tpl_dbl', 'ast_to_ratio', 'stl_to_ratio', 'win_pct',\n308\t    'ws', 'ows', 'dws',\n309\t    't_min', 't_pts', 't_reb', 't_ast', 't_stl', 't_blk', 't_tov',\n310\t    't_fgm', 't_fga', 't_fg3m', 't_fg3a', 't_ftm', 't_fta',\n311\t    'class_year',\n312\t}\n313\t\n314\t\n315\t@app.get(\"/api/players/{season}\")\n316\tdef get_players(\n317\t    season: str,\n318\t    request: Request,\n319\t    sort_col: str = 'final_rating',\n320\t    sort_dir: str = 'desc',\n321\t    limit: int = Query(200, le=200),\n322\t    offset: int = 0\n323\t):\n324\t    \"\"\"Get wide player stats row from ma