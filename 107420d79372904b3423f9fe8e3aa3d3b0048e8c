bl_dbl DESC);\n151\t\n152\t-- Player ratings (calculated)\n153\tCREATE TABLE player_ratings (\n154\t    id SERIAL PRIMARY KEY,\n155\t    player_id VARCHAR(20) REFERENCES players(player_id) ON DELETE CASCADE,\n156\t    season VARCHAR(10) NOT NULL,\n157\t    full_name VARCHAR(255),\n158\t    team VARCHAR(100),\n159\t    position VARCHAR(50),\n160\t    height VARCHAR(10),\n161\t    weight INTEGER,\n162\t    hometown VARCHAR(255),\n163\t    gp INTEGER,\n164\t    minutes DECIMAL(5,2),\n165\t    pts DECIMAL(5,2),\n166\t    fg3m DECIMAL(5,2),\n167\t    fg3_pct DECIMAL(5,4),\n168\t    fgm DECIMAL(5,2),\n169\t    fg_pct DECIMAL(5,4),\n170\t    ft_pct DECIMAL(5,4),\n171\t    ast DECIMAL(5,2),\n172\t    reb DECIMAL(5,2),\n173\t    blk DECIMAL(5,2),\n174\t    stl DECIMAL(5,2),\n175\t    double_doubles INTEGER,\n176\t    triple_doubles INTEGER,\n177\t    -- Percentiles\n178\t    min_per INTEGER,\n179\t    pts_per INTEGER,\n180\t    pm3_per INTEGER,\n181\t    p3pct_per INTEGER,\n182\t    fgm_per INTEGER,\n183\t    fgpct_per INTEGER,\n184\t    ftpct_per INTEGER,\n185\t    ast_per INTEGER,\n186\t    reb_per INTEGER,\n187\t    blk_per INTEGER,\n188\t    stl_per INTEGER,\n189\t    -- Rating components\n190\t    base_rating DECIMAL(6,2),\n191\t    game_adj DECIMAL(6,2),\n192\t    min_boost DECIMAL(6,2),\n193\t    three_boost DECIMAL(6,2),\n194\t    fg_boost DECIMAL(6,2),\n195\t    ast_boost DECIMAL(6,2),\n196\t    blk_boost DECIMAL(6,2),\n197\t    double_double_boost DECIMAL(6,2),\n198\t    triple_double_boost DECIMAL(6,2),\n199\t    free_throw_boost DECIMAL(6,2),\n200\t    final_rating DECIMAL(6,2) NOT NULL,\n201\t    two_way CHAR(1),\n202\t    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n203\t    UNIQUE(player_id, season)\n204\t);\n205\t\n206\tCREATE INDEX idx_ratings_player ON player_ratings(player_id);\n207\tCREATE INDEX idx_ratings_season ON player_ratings(season);\n208\tCREATE INDEX idx_ratings_final ON player_ratings(final_rating DESC);\n209\tCREATE INDEX idx_ratings_team O