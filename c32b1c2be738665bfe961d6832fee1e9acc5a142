_pts',   label: 'PTS',  type: 'num', d: 0 },\n739\t        { col: 't_reb',   label: 'REB',  type: 'num', d: 0 },\n740\t        { col: 't_ast',   label: 'AST',  type: 'num', d: 0 },\n741\t        { col: 't_stl',   label: 'STL',  type: 'num', d: 0 },\n742\t        { col: 't_blk',   label: 'BLK',  type: 'num', d: 0 },\n743\t        { col: 't_tov',   label: 'TO',   type: 'num', d: 0 },\n744\t        { col: 'fg_pct',  label: 'FG%',  type: 'pct' },\n745\t        { col: 't_fg3m',  label: '3PM',  type: 'num', d: 0 },\n746\t        { col: 't_fg3a',  label: '3PA',  type: 'num', d: 0 },\n747\t        { col: 'fg3_pct', label: '3P%',  type: 'pct' },\n748\t        { col: 'ft_pct',  label: 'FT%',  type: 'pct' },\n749\t        { col: 'ts_pct',  label: 'TS%',  type: 'pct' },\n750\t        { col: 'per',     label: 'PER',  type: 'num', d: 1 },\n751\t        { col: 'usg_pct', label: 'USG%', type: 'num', d: 1 },\n752\t        { col: 'ws',      label: 'WS',   type: 'num', d: 2 },\n753\t    ],\n754\t};\n755\t\n756\tfunction getStatDefs() { return displayMode === 'pergame' ? STAT_DEFS_PERGAME : STAT_DEFS_TOTALS; }\n757\tfunction getCols()     { return COL_SETS[displayMode]; }\n758\t\n759\tconst sliderState = {};\n760\tlet allPlayers = [];\n761\tlet currentSeason = '2025-26';\n762\tlet displayMode = 'pergame';\n763\tlet sortCol = 'final_rating';\n764\tlet sortDir = -1;\n765\tlet activePositions = new Set();\n766\tlet activeClassYears = new Set();\n767\tlet currentPage = 1;\n768\tconst PAGE_SIZE = 100;\n769\tlet filteredPlayers = [];\n770\t\n771\t// ── Boot ──────────────────────────────────────────────────────────────────\n772\tdocument.addEventListener('DOMContentLoaded', () => {\n773\t    document.getElementById('seasonSelect').addEventListener('change', e => {\n774\t        currentSeason = e.target.value;\n775\t        currentPage = 1;\n776\t        // Clear all filters before loading new season so stale ranges don't apply\n777\t        Object.keys(sliderState).forEach(k => delete sliderState[k]);\n778\t        activePositions.clear();\n779\t        activeClassYears.clear();\n780\t        document.querySelectorAll('.pos-chip').forEach(c => c.classList.remove('active'));\n781\t        document.getElementById('searchBox').value = '';\n782\t        loadPlayers();\n783\t    });\n784\t    document.getElementById('searchBox').addEventListener('input', applyFilters);\n785\t    loadPlayers();\n786\t});\n787\t\n788\t// ── Data load ─────────────────────────────────────────────────────────────\n789\tasync function loadPlayers() {\n790\t    document.getElementById('loading').style.display = 'block';\n791\t    document.getElementById('tableContainer').style.display = 'none';\n792\t\n793\t    try {\n794\t        const res = await fetch(`${API_BASE}/players/${currentSeason}?limit=15000`);\n795\t        const data = await res.json();\n796\t        allPlayers = data.data.map(p => ({\n797\t            ...p,\n798\t            height_in: parseHeightToInches(p.height),\n799\t        }));\n800\t\n801\t        buildSliders();\n802\t        renderTableHeader();\n803\t        buildPositionChips();\n804\t        buildClassChips();\n805\t        applyFilters();\n806\t\n807\t        document.getElementById('loading').style.display = 'none';\n808\t        document.getElementById('tableContainer').style.display = 'block';\n809\t    } catch (err) {\n810\t        document.getElementById('loading').textContent = 'Error loading data — is the API running?';\n811\t        console.error(err);\n812\t    }\n813\t}\n814\t\n815\t// ── Sliders ───────────────────────────────────────────────────────────────\n816\tfunction buildSliders() {\n817\t    const container = document.getElementById('sliderContainer');\n818\t    container.innerHTML = '';\n819\t    let lastGroup = null;\n820\t\n821\t    getStatDefs().forEach(def => {\n822\t        const vals = allPlayers\n823\t            .map(p => p[def.key] != null ? (def.pct ? Number(p[def.key]) * 100 : Number(p[def.key])) : null)\n824\t            .filter(v => v != null);\n825\t\n826\t        if (!vals.length) return;\n827\t\n828\t        const dataMin = Math.floor(Math.min(...vals) * 10) / 10;\n829\t        const dataMax = Math.ceil(Math.max(...vals) * 10) / 10;\n830\t        const prev = sliderState[def.key];\n831\t        sliderState[def.key] = { dataMin, dataMax, curMin: prev ? prev.curMin : dataMin, curMax: prev ? prev.curMax : dataMax };\n832\t\n833\t        const fmtBound = v => def.formatVal ? def.formatVal(v) : def.pct ? v.toFixed(0) + '%' : v.toFixed(def.decimals);\n834\t\n835\t        const row = document.createElement('div');\n836\t        row.className = 'slider-row';\n837\t        row.innerHTML = `\n838\t            <div class=\"slider-top\">\n839\t                <span class=\"slider-label-wrap\">\n840\t                    <span class=\"slider-label\">${def.label}</span>\n841\t                    <span class=\"slider-clear\" id=\"${def.key}-clear\" title=\"Clear filter\">&times;</span>\n842\t                </span>\n843\t                <span class=\"slider-current\" id=\"${def.key}-current\">any</span>\n844\t            </div>\n845\t            <div class=\"range-wrap\" id=\"${def.key}-wrap\">\n846\t                <div class=\"range-track\">\n847\t                    <div class=\"range-fill\" id=\"${def.key}-fill\"></div>\n848\t                </div>\n849\t                <div class=\"range-thumb\" id=\"${def.key}-min-thumb\"></div>\n850\t                <div class=\"range-thumb\" id=\"${def.key}-max-thumb\"></div>\n851\t            </div>\n852\t            <div class=\"range-bounds\">\n853\t                <span>${fmtBound(dataMin)}</span>\n854\t                <span>${fmtBound(dataMax)}</span>\n855\t            </div>\n856\t        `;\n857\t        container.appendChild(row);\n858\t\n859\t        initThumb(def);\n860\t        document.getElementById(`${def.key}-clear`).addEventListener('click', () => clearSlider(def));\n861\t        updateSliderUI(def);\n862\t    });\n863\t}\n864\t\n865\tfunction initThumb(def) {\n866\t    const wrapEl = document.getElementById(`${def.key}-wrap`);\n867\t    const step = def.decimals === 0 ? 1 : def.pct ? 1 : Math.pow(10, -def.decimals);\n868\t\n869\t    const pctToVal = (pct) => {\n870\t        const s = sliderState[def.key];\n871\t        let val = s.dataMin + pct * (s.dataMax - s.dataMin);\n872\t        val = Math.round(val / step) * step;\n873\t        val = parseFloat(val.toFixed(def.decimals));\n874\t        return Math.max(s.dataMin, Math.min(s.dataMax, val));\n875\t    };\n876\t\n877\t    wrapEl.addEventListener('pointerdown', e => {\n878\t        e.preventDefault();\n879\t        wrapEl.setPointerCapture(e.pointerId);\n880\t\n881\t        const rect = wrapEl.getBoundingClientRect();\n882\t        const clickPct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));\n883\t        const s = sliderState[def.key];\n884\t        const span = s.dataMax - s.dataMin || 1;\n885\t        const minPct = (s.curMin - s.dataMin) / span;\n886\t        const maxPct = (s.curMax - s.dataMin) / span;\n887\t\n888\t        // Pick the closest thumb; if tied, prefer min when clicking left, max when clicking right\n889\t        const distMin = Math.abs(clickPct - minPct);\n890\t        const distMax = Math.abs(clickPct - maxPct);\n891\t        let handle = distMin <= distMax ? 'min' : 'max';\n892\t\n893\t        const onMove = e => {\n894\t            const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));\n895\t            const val = pctToVal(pct);\n896\t            if (handle === 'min') {\n897\t                s.curMin = Math.min(val, s.curMax);\n898\t            } else {\n899\t                s.curMax = Math.max(val, s.curMin);\n900\t            }\n901\t            updateSliderUI(def);\n902\t            applyFilters();\n903\t        };\n904\t\n905\t        wrapEl.addEventListener('pointermove', onMove);\n906\t        wrapEl.addEventListener('pointerup', () => {\n907\t            wrapEl.removeEventListener('pointermove', onMove);\n908\t        }, { once: true });\n909\t\n910\t        // Fire immediately so a click (no move) still updates\n911\t        onMove(e);\n912\t    });\n913\t}\n914\t\n915\tfunction updateSliderUI(def) {\n916\t    const s = sliderState[def.key];\n917\t    if (!s) return;\n918\t\n919\t    const { dataMin, dataMax, curMin, curMax } = s;\n920\t    const span = dataMax - dataMin || 1;\n921\t    const leftPct  = (curMin - dataMin) / span * 100;\n922\t    const rightPct = (curMax - dataMin) / span * 100;\n923\t\n924\t    document.getElementById(`${def.key}-fill`).style.cssText =\n925\t        `left:${leftPct}%; width:${rightPct - leftPct}%`;\n926\t    document.getElementById(`${def.key}-min-thumb`).style.left = `${leftPct}%`;\n927\t    document.getElementById(`${def.key}-max-thumb`).style.left = `${rightPct}%`;\n928\t\n929\t    const fmtV = v => def.formatVal ? def.formatVal(v) : def.pct ? v.toFixed(def.decimals) + '%' : v.toFixed(def.decimals);\n930\t    const isDefault = curMin === dataMin && curMax === dataMax;\n931\t    document.getElementById(`${def.key}-current`).textContent =\n932\t        isDefault ? 'any' : `${fmtV(curMin)} – ${fmtV(curMax)}`;\n933\t\n934\t    const clearEl = document.getElementById(`${def.key}-clear`);\n935\t    if (clearEl) clearEl.style.display = isDefault ? 'none' : 'inline-block';\n936\t}\n937\t\n938\tfunction clearSlider(def) {\n939\t    const s = sliderState[def.key];\n940\t    if (!s) return;\n941\t    s.curMin = s.dataMin;\n942\t    s.curMax = s.dataMax;\n943\t    updateSliderUI(def);\n944\t    applyFilters();\n945\t}\n946\t\n947\t// ── Position chips (pos_group) ────────────────────────────────────────────\n948\tfunction buildPositionChips() {\n949\t    const groups = ['Guard', 'Wing', 'Big'];\n950\t    const container = document.getElementById('posChips');\n951\t    container.innerHTML = '';\n952\t    activePositions.clear();\n953\t\n954\t    groups.forEach(pos => {\n955\t        const chip = document.createElement('div');\n956\t        chip.className = 'pos-chip';\n957\t        chip.textContent = pos;\n958\t        chip.addEventListener('click', () => {\n959\t            if (activePositions.has(pos)) { activePositions.delete(pos); chip.classList.remove('active'); }\n960\t            else                          { activePositions.add(pos);    chip.classList.add('active'); }\n961\t            applyFilters();\n962\t        });\n963\t        container.appendChild(chip);\n964\t    });\n965\t}\n966\t\n967\t\n968\t// ── Class year chips ──────────────────────────────────────────────────────\n969\tfunction buildClassChips() {\n970\t    const yearOrder = ['Fr', 'So', 'Jr', 'Sr', 'Grad', '5th Year', 'RS Fr', 'RS So', 'RS Jr', 'RS Sr'];\n971\t    const found = [...new Set(allPlayers.map(p => p.class_year).filter(Boolean))];\n972\t    found.sort((a, b) => {\n973\t        const ai = yearOrder.indexOf(a), bi = yearOrder.indexOf(b);\n974\t        if (ai !== -1 && bi !== -1) return ai - bi;\n975\t        if (ai !== -1) return -1;\n976\t        if (bi !== -1) return 1;\n977\t        return a.localeCompare(b);\n978\t    });\n979\t\n980\t    const container = document.getElementById('classChips');\n981\t    container.innerHTML = '';\n982\t    activeClassYears.clear();\n983\t\n984\t    found.forEach(yr => {\n985\t        const chip = document.createElement('div');\n986\t        chip.className = 'pos-chip';\n987\t        chip.textContent = yr;\n988\t        chip.addEventListener('click', () => {\n989\t            if (activeClassYears.has(yr)) { activeClassYears.delete(yr); chip.classList.remove('active'); }\n990\t            else                          { activeClassYears.add(yr);    chip.classList.add('active'); }\n991\t            applyFilters();\n992\t        });\n993\t        container.appendChild(chip);\n994\t    });\n995\t}\n996\t\n997\t// ── Filter + render ───────────────────────────────────────────────────────\n998\tfunction applyFilters() {\n999\t    const search = document.getElementById('searchBox').value.toLowerCase().trim();\n1000\t\n1001\t    let filtered = allPlayers.filter(p => {\n1002\t        if (search && !p.full_name.toLowerCase().includes(search)) return false;\n1003\t        if (activePositions.size > 0 && !activePositions.has(p.pos_group)) return false;\n1004\t        if (activeClassYears.size > 0 && !activeClassYears.has(p.class_year)) return false;\n1005\t\n1006\t        for (const def of getStatDefs()) {\n1007\t            const s = sliderState[def.key];\n1008\t            if (!s || (s.curMin === s.dataMin && s.curMax === s.dataMax)) continue;\n1009\t            const raw = p[def.key];\n1010\t            if (raw == null) return false;\n1011\t            const v = def.pct ? Number(raw) * 100 : Number(raw);\n1012\t            if (v < s.curMin || v > s.curMax) return false;\n1013\t        }\n1014\t\n1015\t        return true;\n1016\t    });\n1017\t\n1018\t    filtered.sort((a, b) => {\n1019\t        const av = a[sortCol], bv = b[sortCol];\n1020\t        if (av == null && bv == null) return 0;\n1021\t        if (av == null) return 1;\n1022\t        if (bv == null) return -1;\n1023\t        return typeof av === 'string' ? av.localeCompare(bv) * sortDir : (av - bv) * sortDir;\n1024\t    });\n1025\t\n1026\t    filteredPlayers = filtered;\n1027\t    currentPage = 1;\n1028\t    document.getElementById('resultsCount').textContent =\n1029\t        `${filtered.length.toLocaleString()} player${filtered.length !== 1 ? 's' : ''}`;\n1030\t    renderPage();\n1031\t}\n1032\t\n1033\tfunction fmt(v, d = 1)  { return v != null ? Number(v).toFixed(d) : '-'; }\n1034\tfunction fmtP(v, d = 1) { return v != null ? (Number(v) * 100).toFixed(d) + '%' : '-'; }\n1035\t\n1036\tfunction renderPage() {\n1037\t    const totalPages = Math.ceil(filteredPlayers.length / PAGE_SIZE);\n1038\t    const start = (currentPage - 1) * PAGE_SIZE;\n1039\t    const pageRows = filteredPlayers.slice(start, start + PAGE_SIZE);\n1040\t    renderTable(pageRows, start);\n1041\t    renderPagination(totalPages);\n1042\t    updateSortHighlight();\n1043\t    if (currentView === 'map') updateMapMarkers();\n1044\t}\n1045\t\n1046\tfunction updateSortHighlight() {\n1047\t    document.querySelectorAll('td.sort-col').forEach(el => el.classList.remove('sort-col'));\n1048\t    document.querySelectorAll(`td[data-col=\"${sortCol}\"]`).forEach(el => el.classList.add('sort-col'));\n1049\t}\n1050\t\n1051\tfunction fmtCol(c, val) {\n1052\t    if (c.type === 'pct') return fmtP(val);\n1053\t    return fmt(val, c.d ?? 1);\n1054\t}\n1055\t\n1056\tfunction renderTableHeader() {\n1057\t    const cols = getCols();\n1058\t    const tr = document.createElement('tr');\n1059\t    tr.innerHTML = `\n1060\t        <th style=\"cursor:default\">#</th>\n1061\t        <th style=\"cursor:default;width:28px\" title=\"Find similar players\"></th>\n1062\t        <th data-col=\"full_name\" style=\"min-width:145px\">Player</th>\n1063\t        <th data-col=\"team\" style=\"min-width:115px\">Team</th>\n1064\t        <th data-col=\"final_rating\" class=\"${sortCol === 'final_rating' ? (sortDir === -1 ? 'sort-desc' : 'sort-asc') : ''}\">Rating</th>\n1065\t        <th data-col=\"position\">Pos</th>\n1066\t        <th data-col=\"class_year\">Yr</th>\n1067\t        <th data-col=\"height_in\">Ht</th>\n1068\t        <th data-col=\"weight\">Wt</th>\n1069\t        <th data-col=\"gp\">GP</th>\n1070\t        ${cols.map(c => `<th data-col=\"${c.col}\">${c.label}</th>`).join('')}\n1071\t    `;\n1072\t    const thead = document.getElementById('tableHead');\n1073\t    thead.innerHTML = '';\n1074\t    thead.appendChild(tr);\n1075\t\n1076\t    // Re-attach sort listeners\n1077\t    thead.querySelectorAll('th[data-col]').forEach(th => {\n1078\t        th.addEventListener('click', () => {\n1079\t            const col = th.dataset.col;\n1080\t            sortDir = sortCol === col ? sortDir * -1 : -1;\n1081\t            sortCol = col;\n1082\t            thead.querySelectorAll('th').forEach(t => t.classList.remove('sort-asc','sort-desc'));\n1083\t            th.classList.add(sortDir === -1 ? 'sort-desc' : 'sort-asc');\n1084\t            applyFilters();\n1085\t        });\n1086\t        // Mark active sort col\n1087\t        if (th.dataset.col === sortCol) {\n1088\t            th.classList.add(sortDir === -1 ? 'sort-desc' : 'sort-asc');\n1089\t        }\n1090\t    });\n1091\t}\n1092\t\n1093\tfunction renderTable(players, offset = 0) {\n1094\t    const cols = getCols();\n1095\t    const tbody = document.getElementById('tableBody');\n1096\t    tbody.innerHTML = '';\n1097\t\n1098\t    players.forEach((p, i) => {\n1099\t        const tr = document.createElement('tr');\n1100\t        tr.addEventListener('click', () => window.location.href = `/player.html?id=${p.player_id}`);\n1101\t        const varCells = cols.map(c => `<td data-col=\"${c.col}\">${fmtCol(c, p[c.col])}</td>`).join('');\n1102\t        tr.innerHTML = `\n1103\t            <td style=\"color:#ccc;font-size:.88em\">${offset + i + 1}</td>\n1104\t            <td class=\"sim-cell\" onclick=\"event.stopPropagation();applyPlayerFilters(${p.player_id})\">≈</td>\n1105\t            <td data-col=\"full_name\"><span class=\"player-name\">${p.full_name}</span></td>\n1106\t            <td data-col=\"team\">${p.team || '-'}</td>\n1107\t            <td data-col=\"final_rating\" class=\"rating-cell\">${fmt(p.final_rating)}</td>\n1108\t            <td data-col=\"position\">${p.position || '-'}</td>\n1109\t            <td data-col=\"class_year\" style=\"color:#aaa\">${p.class_year || '-'}</td>\n1110\t            <td data-col=\"height_in\" style=\"color:#aaa\">${p.height || '-'}</td>\n1111\t            <td data-col=\"weight\" style=\"color:#aaa\">${p.weight ?? '-'}</td>\n1112\t            <td data-col=\"gp\">${p.gp ?? '-'}</td>\n1113\t            ${varCells}\n1114\t        `;\n1115\t        tbody.appendChild(tr);\n1116\t    });\n1117\t}\n1118\t\n1119\tfunction setDisplayMode(mode) {\n1120\t    displayMode = mode;\n1121\t    document.getElementById('btnPergame').classList.toggle('active', mode === 'pergame');\n1122\t    document.getElementById('btnTotals').classList.toggle('active', mode === 'totals');\n1123\t    sortCol = 'final_rating';\n1124\t    sortDir = -1;\n1125\t    buildSliders();\n1126\t    renderTableHeader();\n1127\t    applyFilters();\n1128\t}\n1129\t\n1130\tfunction renderPagination(totalPages) {\n1131\t    const header = document.getElementById('paginationHeader');\n1132\t    const el = document.getElementById('pagination');\n1133\t    header.style.display = 'flex';\n1134\t    el.style.display = totalPages <= 1 ? 'none' : '';\n1135\t    if (totalPages <= 1) return;\n1136\t\n1137\t    const start = (currentPage - 1) * PAGE_SIZE + 1;\n1138\t    const end = Math.min(currentPage * PAGE_SIZE, filteredPlayers.length);\n1139\t\n1140\t    // Show up to 7 page buttons around current page\n1141\t    const pages = [];\n1142\t    for (let i = 1; i <= totalPages; i++) {\n1143\t        if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {\n1144\t            pages.push(i);\n1145\t        }\n1146\t    }\n1147\t\n1148\t    let html = `<button class=\"pg-btn\" ${currentPage === 1 ? 'disabled' : ''} onclick=\"goPage(${currentPage - 1})\">← Prev</button>`;\n1149\t    let prev = null;\n1150\t    pages.forEach(p => {\n1151\t        if (prev && p - prev > 1) html += `<span class=\"pg-info\">…</span>`;\n1152\t        html += `<button class=\"pg-btn ${p === currentPage ? 'active' : ''}\" onclick=\"goPage(${p})\">${p}</button>`;\n1153\t        prev = p;\n1154\t    });\n1155\t    html += `<button class=\"pg-btn\" ${currentPage === totalPages ? 'disabled' : ''} onclick=\"goPage(${currentPage + 1})\">Next →</button>`;\n1156\t    html += `<span class=\"pg-info\">${start}–${end} of ${filteredPlayers.length.toLocaleString()}</span>`;\n1157\t\n1158\t    el.innerHTML = html;\n1159\t}\n1160\t\n1161\tfunction goPage(page) {\n1162\t    currentPage = page;\n1163\t    renderPage();\n1164\t    document.getElementById('tableContainer').scrollIntoView({ behavior: 'smooth', block: 'start' });\n1165\t}\n1166\t\n1167\t// ── Reset ─────────────────────────────────────────────────────────────────\n1168\tfunction resetFilters() {\n1169\t    getStatDefs().forEach(def => {\n1170\t        const s = sliderState[def.key];\n1171\t        if (!s) return;\n1172\t        s.curMin = s.dataMin;\n1173\t        s.curMax = s.dataMax;\n1174\t        updateSliderUI(def);\n1175\t    });\n1176\t    activePositions.clear();\n1177\t    activeClassYears.clear();\n1178\t    document.querySelectorAll('.pos-chip').forEach(c => c.classList.remove('active'));\n1179\t    document.getElementById('searchBox').value = '';\n1180\t    applyFilters();\n1181\t}\n1182\t\n1183\t// ── Modal ─────────────────────────────────────────────────────────────────\n1184\tfunction showModal(playerId) {\n1185\t    const p = allPlayers.find(x => x.player_id == playerId);\n1186\t    if (!p) return;\n1187\t    document.getElementById('playerModal').classList.add('show');\n1188\t\n1189\t    document.getElementById('playerDetails').innerHTML = `\n1190\t        <div class=\"player-header\">\n1191\t            <h2>${p.full_name}</h2>\n1192\t            <div class=\"meta\">\n1193\t                ${p.team || '-'} &nbsp;|&nbsp; ${p.position || '-'} &nbsp;|&nbsp;\n1194\t                ${p.class_year || '-'} &nbsp;|&nbsp;\n1195\t                ${p.height || '-'} &nbsp;|&nbsp; ${p.weight ? p.weight + ' lbs' : '-'}\n1196\t                ${p.age != null ? ' &nbsp;|&nbsp; Age ' + p.age : ''}\n1197\t                ${p.hometown ? ' &nbsp;|&nbsp; ' + p.hometown : ''}\n1198\t            </div>\n1199\t            <a class=\"realgm-link\" href=\"https://basketball.realgm.com/player/x/Summary/${p.player_id}\" target=\"_blank\">View on RealGM</a>\n1200\t            <button class=\"btn-apply-filters\" onclick=\"applyPlayerFilters(${p.player_id})\">Find Players Like This &rarr;</button>\n1201\t        </div>\n120