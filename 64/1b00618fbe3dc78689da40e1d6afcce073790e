ss=\"pg-btn\" ${currentPage === 1 ? 'disabled' : ''} onclick=\"goPage(${currentPage - 1})\">← Prev</button>`;\n1367\t    let prev = null;\n1368\t    pages.forEach(p => {\n1369\t        if (prev && p - prev > 1) html += `<span class=\"pg-info\">…</span>`;\n1370\t        html += `<button class=\"pg-btn ${p === currentPage ? 'active' : ''}\" onclick=\"goPage(${p})\">${p}</button>`;\n1371\t        prev = p;\n1372\t    });\n1373\t    if (filtered && hasMoreData) html += `<span class=\"pg-info\">…</span>`;\n1374\t    const nextDisabled = currentPage === totalPages && (!hasMoreData || !filtered);\n1375\t    html += `<button class=\"pg-btn\" ${nextDisabled ? 'disabled' : ''} onclick=\"goPage(${currentPage + 1})\">Next →</button>`;\n1376\t    html += `<span class=\"pg-info\">${start}–${end} of ${displayTotal.toLocaleString()}${ofSuffix}</span>`;\n1377\t\n1378\t    el.innerHTML = html;\n1379\t}\n1380\t\n1381\tasync function goPage(page) {\n1382\t    const neededCount = page * PAGE_SIZE;\n1383\t    if (neededCount > filteredPlayers.length && hasMoreData && !isFetchingMore) {\n1384\t        await fetchBatch();\n1385\t        filteredPlayers = [...allPlayers];\n1386\t        const filtered = isFiltered();\n1387\t        const displayCount = filtered ? filteredPlayers.length : (totalSeasonCount || filteredPlayers.length);\n1388\t        const suffix = filtered && hasMoreData ? '+' : '';\n1389\t        document.getElementById('resultsCount').textContent =\n1390\t            `${displayCount.toLocaleString()}${suffix} player${displayCount !== 1 ? 's' : ''}`;\n1391\t    }\n1392\t    currentPage = page;\n1393\t    renderPage();\n1394\t    document.getElementById('tableContainer').scrollIntoView({ behavior: 'smooth', block: 'start' });\n1395\t}\n1396\t\n1397\t// ── Reset ─────────────────────────────────────────────────────────────────\n1398\tfunction resetFilters() {\n1399\t    getStatDefs().forEach(def => {\n1400\t        const s = sliderState[def.key];\n1401\t        if (!s) return;