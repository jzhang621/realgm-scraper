ey: 'fta',           label: 'FTA' },\n825\t    { key: 'ft_pct',        label: 'FT%',   pct: true },\n826\t    { key: 'efg_pct',       label: 'eFG%',  pct: true },\n827\t    { key: 'ts_pct',        label: 'TS%',   pct: true },\n828\t    { key: 'per',           label: 'PER' },\n829\t    { key: 'usg_pct',       label: 'USG%' },\n830\t    { key: 'ortg',          label: 'ORTG' },\n831\t    { key: 'drtg',          label: 'DRTG' },\n832\t    { key: 'orb_pct',       label: 'ORB%' },\n833\t    { key: 'drb_pct',       label: 'DRB%' },\n834\t    { key: 'ast_pct',       label: 'AST%' },\n835\t    { key: 'tov_pct',       label: 'TOV%' },\n836\t    { key: 'stl_pct',       label: 'STL%' },\n837\t    { key: 'blk_pct',       label: 'BLK%' },\n838\t    { key: 'ast_to_ratio',  label: 'AST/TO' },\n839\t    { key: 'stl_to_ratio',  label: 'STL/TO' },\n840\t    { key: 'ws',            label: 'Win Shares' },\n841\t    { key: 'ows',           label: 'OWS' },\n842\t    { key: 'dws',           label: 'DWS' },\n843\t    { key: 'win_pct',       label: 'Win%',  pct: true },\n844\t    { key: 'pps',           label: 'PPS' },\n845\t    { key: 'ppr',           label: 'PPR' },\n846\t    { key: 'dbl_dbl',       label: 'Dbl-Dbl' },\n847\t    { key: 'tpl_dbl',       label: 'Tpl-Dbl' },\n848\t    { key: 't_min',         label: 'Total MIN' },\n849\t    { key: 't_pts',         label: 'Total PTS' },\n850\t    { key: 't_reb',         label: 'Total REB' },\n851\t    { key: 't_ast',         label: 'Total AST' },\n852\t    { key: 't_stl',         label: 'Total STL' },\n853\t    { key: 't_blk',         label: 'Total BLK' },\n854\t    { key: 't_tov',         label: 'Total TOV' },\n855\t];\n856\t\n857\tfunction updateExportButton() {\n858\t    const n = selectedPlayerIds.size;\n859\t    document.getElementById('exportBtn').style.display = n > 0 ? '' : 'none';\n860\t    document.getElementById('exportCount').textContent = n;\n861\t}\n862\t\n863\tfunction exportToCSV() {\n864\t    const players = allPlayers.filter(p => selectedPlayerIds.has(String(p.player_id)));\n865\t    if (!players.length) return;\n866\t\n867\t    const header = EXPORT_COLS.map(c => `\"${c.label}\"`).join(',');\n868\t    const rows = players.map(p =>\n869\t        EXPORT_COLS.map(c => {\n870\t            let v = p[c.key];\n871\t            if (v == null) return '';\n872\t            if (c.pct) v = (Number(v) * 100).toFixed(1);\n873\t            return `\"${String(v).replace(/\"/g, '\"\"')}\"`;\n874\t        }).join(',')\n875\t    );\n876\t\n877\t    const csv = [header, ...rows].join('\\n');\n878\t    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });\n879\t    const url = URL.createObjectURL(blob);\n880\t    const a = document.createElement('a');\n881\t    a.href = url;\n882\t    a.download = `nil-pro-${currentSeason}-${players.length}players.csv`;\n883\t    document.body.appendChild(a);\n884\t    a.click();\n885\t    document.body.removeChild(a);\n886\t    URL.revokeObjectURL(url);\n887\t}\n888\t\n889\t// ── Boot ──────────────────────────────────────────────────────────────────\n890\tdocument.addEventListener('DOMContentLoaded', () => {\n891\t    document.getElementById('seasonSelect').addEventListener('change', e => {\n892\t        currentSeason = e.target.value;\n893\t        currentPage = 1;\n894\t        // Clear all filters before loading new season so stale ranges don't apply\n895\t        Object.keys(sliderState).forEach(k => delete sliderState[k]);\n896\t        activePositions.clear();\n897\t        activeClassYears.clear();\n898\t        document.querySelectorAll('.pos-chip').forEach(c => c.classList.remove('active'));\n899\t        document.getElementById('searchBox').value = '';\n900\t        loadPlayers();\n901\t    });\n902\t    let searchDebounce = null;\n903\t    document.getElementById('searchBox').addEventListener('input', () => {\n904\t        clearTimeout(searchDebounce);\n905\t        searchDebounce = setTimeout(applyFilters, 300);\n906\t    });\n907\t    loadPlayers();\n908\t});\n909\t\n910\t// ── Data load ─────────────────────────────────────────────────────────────\n911\tasync function loadPlayers() {\n912\t    const loadingEl = document.getElementById('loading');\n913\t    loadingEl.style.display = 'block';\n914\t    loadingEl.textContent = 'Loading...';\n915\t    document.getElementById('tableContainer').style.display = 'none';\n916\t\n917\t    allPlayers = [];\n918\t    serverOffset = 0;\n919\t    hasMoreData = true;\n920\t    statRanges = {};\n921\t    totalSeasonCount = 0;\n922\t    selectedPlayerIds.clear();\n923\t    updateExportButton();\n924\t\n925\t    const MAX_ATTEMPTS = 4;\n926\t    const RETRY_DELAY = 5000; // 5s between retries while server wakes up\n927\t\n928\t    for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {\n929\t        try {\n930\t            const [, rangesRes, countRes] = await Promise.all([\n931\t                fetchBatch(),\n932\t                fetch(`${API_BASE}/stat-ranges/${currentSeason}`).then(r => r.json()),\n933\t                fetch(`${API_BASE}/player-count/${currentSeason}`).then(r => r.json()),\n934\t            ]);\n935\t            statRanges = rangesRes.ranges || {};\n936\t            totalSeasonCount = countRes.count || 0;\n937\t\n938\t            buildSliders();\n939\t            renderTableHeader();\n940\t            buildPositionChips();\n941\t            buildClassChips();\n942\t            applyFilters();\n943\t\n944\t            loadingEl.style.display = 'none';\n945\t            document.getElementById('tableContainer').style.display = 'block';\n946\t            return;\n947\t        } catch (err) {\n948\t            console.error(`Load attempt ${attempt} failed:`, err);\n949\t            if (attempt < MAX_ATTEMPTS) {\n950\t                loadingEl.textContent = `Waking up server… retrying (${attempt}/${MAX_ATTEMPTS - 1})`;\n951\t                await new Promise(res => setTimeout(res, RETRY_DELAY));\n952\t                allPlayers = [];\n953\t                serverOffset = 0;\n954\t                hasMoreData = true;\n955\t            } else {\n956\t                loadingEl.textContent = 'Error loading data — please refresh the page.';\n957\t            }\n958\t        }\n959\t    }\n960\t}\n961\t\n962\tfunction buildFilterParams() {\n963\t    const params = new URLSearchParams();\n964\t    const search = document.getElementById('searchBox').value.trim();\n965\t    if (search) params.set('search', search);\n966\t    if (activePositions.size > 0) params.set('pos_group', [...activePositions].join(','));\n967\t    if (activeClassYears.size > 0) params.set('class_year', [...activeClassYears].join(','));\n968\t\n969\t    const seen = new Set();\n970\t    for (const def of getStatDefs()) {\n971\t        if (seen.has(def.key)) continue;\n972\t        seen.add(def.key);\n973\t        const s = sliderState[def.key];\n974\t        if (!s) continue;\n975\t        const scale = def.pct ? 100 : 1;\n976\t        if (s.curMin !== s.dataMin) params.set(`${def.key}_min`, s.curMin / scale);\n977\t        if (s.curMax !== s.dataMax) params.set(`${def.key}_max`, s.curMax / scale);\n978\t    }\n979\t    return params;\n980\t}\n981\t\n982\tasync function fetchBatch() {\n983\t    if (isFetchingMore || !hasMoreData) return;\n984\t    isFetchingMore = true;\n985\t    const dir = sortDir === -1 ? 'desc' : 'asc';\n986\t    const params = buildFilterParams();\n987\t    params.set('limit', FETCH_SIZE);\n988\t    params.set('offset', serverOffset);\n989\t    params.set('sort_col', sortCol);\n990\t    params.set('sort_dir', dir);\n991\t    const res = await fetch(`${API_BASE}/players/${currentSeason}?${params}`);\n992\t    const data = await res.json();\n993\t    const batch = data.data.map(p => ({ ...p, height_in: parseHeightToInches(p.height) }));\n994\t    allPlayers = [...allPlayers, ...batch];\n995\t    serverOffset += batch.length;\n996\t    hasMoreData = batch.length === FETCH_SIZE;\n997\t    isFetchingMore = false;\n998\t}\n999\t\n1000\t// ── Sliders ───────────────────────────────────────────────────────────────\n1001\tfunction buildSliders() {\n1002\t    const container = document.getElementById('sliderContainer');\n1003\t    container.innerHTML = '';\n1004\t    let lastGroup = null;\n1005\t\n1006\t    getStatDefs().forEach(def => {\n1007\t        let dataMin, dataMax;\n1008\t        const r = statRanges[def.key];\n1009\t        if (r && r.min != null && r.max != null) {\n1010\t            const scale = def.pct ? 100 : 1;\n1011\t            dataMin = Math.floor(Number(r.min) * scale * 10) / 10;\n1012\t            dataMax = Math.ceil(Number(r.max) * scale * 10) / 10;\n1013\t        } else {\n1014\t            const vals = allPlayers\n1015\t                .map(p => p[def.key] != null ? (def.pct ? Number(p[def.key]) * 100 : Number(p[def.key])) : null)\n1016\t                .filter(v => v != null);\n1017\t            if (!vals.length) return;\n1018\t            dataMin = Math.floor(Math.min(...vals) * 10) / 10;\n1019\t            dataMax = Math.ceil(Math.max(...vals) * 10) / 10;\n1020\t        }\n1021\t\n1022\t        const prev = sliderState[def.key];\n1023\t        sliderState[def.key] = { dataMin, dataMax, curMin: prev ? prev.curMin : dataMin, curMax: prev ? prev.curMax : dataMax };\n1024\t\n1025\t        const fmtBound = v => def.formatVal ? def.formatVal(v) : def.pct ? v.toFixed(0) + '%' : v.toFixed(def.decimals);\n1026\t\n1027\t        const row = document.createElement('div');\n1028\t        row.className = 'slider-row';\n1029\t        row.innerHTML = `\n1030\t            <div class=\"slider-top\">\n1031\t                <span class=\"slider-label-wrap\">\n1032\t                    <span class=\"slider-label\">${def.label}</span>\n1033\t                    <span class=\"slider-clear\" id=\"${def.key}-clear\" title=\"Clear filter\">&times;</span>\n1034\t                </span>\n1035\t                <span class=\"slider-current\" id=\"${def.key}-current\">any</span>\n1036\t            </div>\n1037\t            <div class=\"range-wrap\" id=\"${def.key}-wrap\">\n1038\t                <div class=\"range-track\">\n1039\t                    <div class=\"range-fill\" id=\"${def.key}-fill\"></div>\n1040\t                </div>\n1041\t                <div class=\"range-thumb\" id=\"${def.key}-min-thumb\"></div>\n1042\t                <div class=\"range-thumb\" id=\"${def.key}-max-thumb\"></div>\n1043\t            </div>\n1044\t            <div class=\"range-bounds\">\n1045\t                <span>${fmtBound(dataMin)}</span>\n1046\t                <span>${fmtBound(dataMax)}</span>\n1047\t            </div>\n1048\t        `;\n1049\t        container.appendChild(row);\n1050\t\n1051\t        initThumb(def);\n1052\t        document.getElementById(`${def.key}-clear`).addEventListener('click', () => clearSlider(def));\n1053\t        updateSliderUI(def);\n1054\t    });\n1055\t}\n1056\t\n1057\tfunction initThumb(def) {\n1058\t    const wrapEl = document.getElementById(`${def.key}-wrap`);\n1059\t    const step = def.decimals === 0 ? 1 : def.pct ? 1 : Math.pow(10, -def.decimals);\n1060\t\n1061\t    const pctToVal = (pct) => {\n1062\t        const s = sliderState[def.key];\n1063\t        let val = s.dataMin + pct * (s.dataMax - s.dataMin);\n1064\t        val = Math.round(val / step) * step;\n1065\t        val = parseFloat(val.toFixed(def.decimals));\n1066\t        return Math.max(s.dataMin, Math.min(s.dataMax, val));\n1067\t    };\n1068\t\n1069\t    wrapEl.addEventListener('pointerdown', e => {\n1070\t        e.preventDefault();\n1071\t        wrapEl.setPointerCapture(e.pointerId);\n1072\t\n1073\t        const rect = wrapEl.getBoundingClientRect();\n1074\t        const clickPct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));\n1075\t        const s = sliderState[def.key];\n1076\t        const span = s.dataMax - s.dataMin || 1;\n1077\t        const minPct = (s.curMin - s.dataMin) / span;\n1078\t        const maxPct = (s.curMax - s.dataMin) / span;\n1079\t\n1080\t        // Pick the closest thumb; if tied, prefer min when clicking left, max when clicking right\n1081\t        const distMin = Math.abs(clickPct - minPct);\n1082\t        const distMax = Math.abs(clickPct - maxPct);\n1083\t        let handle = distMin <= distMax ? 'min' : 'max';\n1084\t\n1085\t        const onMove = e => {\n1086\t            const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));\n1087\t            const val = pctToVal(pct);\n1088\t            if (handle === 'min') {\n1089\t                s.curMin = Math.min(val, s.curMax);\n1090\t            } else {\n1091\t                s.curMax = Math.max(val, s.curMin);\n1092\t            }\n1093\t            updateSliderUI(def);\n1094\t        };\n1095\t\n1096\t        wrapEl.addEventListener('pointermove', onMove);\n1097\t        wrapEl.addEventListener('pointerup', () => {\n1098\t            wrapEl.removeEventListener('pointermove', onMove);\n1099\t            applyFilters();\n1100\t        }, { once: true });\n1101\t\n1102\t        // Fire immediately so a click (no move) still updates the UI;\n1103\t        // applyFilters fires on pointerup which follows immediately after\n1104\t        onMove(e);\n1105\t    });\n1106\t}\n1107\t\n1108\tfunction updateSliderUI(def) {\n1109\t    const s = sliderState[def.key];\n1110\t    if (!s) return;\n1111\t\n1112\t    const { dataMin, dataMax, curMin, curMax } = s;\n1113\t    const span = dataMax - dataMin || 1;\n1114\t    const leftPct  = (curMin - dataMin) / span * 100;\n1115\t    const rightPct = (curMax - dataMin) / span * 100;\n1116\t\n1117\t    document.getElementById(`${def.key}-fill`).style.cssText =\n1118\t        `left:${leftPct}%; width:${rightPct - leftPct}%`;\n1119\t    document.getElementById(`${def.key}-min-thumb`).style.left = `${leftPct}%`;\n1120\t    document.getElementById(`${def.key}-max-thumb`).style.left = `${rightPct}%`;\n1121\t\n1122\t    const fmtV = v => def.formatVal ? def.formatVal(v) : def.pct ? v.toFixed(def.decimals) + '%' : v.toFixed(def.decimals);\n1123\t    const isDefault = curMin === dataMin && curMax === dataMax;\n1124\t    document.getElementById(`${def.key}-current`).textContent =\n1125\t        isDefault ? 'any' : `${fmtV(curMin)} – ${fmtV(curMax)}`;\n1126\t\n1127\t    const clearEl = document.getElementById(`${def.key}-clear`);\n1128\t    if (clearEl) clearEl.style.display = isDefault ? 'none' : 'inline-block';\n1129\t}\n1130\t\n1131\tfunction clearSlider(def) {\n1132\t    const s = sliderState[def.key];\n1133\t    if (!s) return;\n1134\t    s.curMin = s.dataMin;\n1135\t    s.curMax = s.dataMax;\n1136\t    updateSliderUI(def);\n1137\t    applyFilters();\n1138\t}\n1139\t\n1140\t// ── Position chips (pos_group) ────────────────────────────────────────────\n1141\tfunction buildPositionChips() {\n1142\t    const groups = ['Guard', 'Wing', 'Big'];\n1143\t    const container = document.getElementById('posChips');\n1144\t    container.innerHTML = '';\n1145\t    activePositions.clear();\n1146\t\n1147\t    groups.forEach(pos => {\n1148\t        const chip = document.createElement('div');\n1149\t        chip.className = 'pos-chip';\n1150\t        chip.textContent = pos;\n1151\t        chip.addEventListener('click', () => {\n1152\t            if (activePositions.has(pos)) { activePositions.delete(pos); chip.classList.remove('active'); }\n1153\t            else                          { activePositions.add(pos);    chip.classList.add('active'); }\n1154\t            applyFilters();\n1155\t        });\n1156\t        container.appendChild(chip);\n1157\t    });\n1158\t}\n1159\t\n1160\t\n1161\t// ── Class year chips ──────────────────────────────────────────────────────\n1162\tfunction buildClassChips() {\n1163\t    const yearOrder = ['Fr', 'So', 'Jr', 'Sr', 'Grad', '5th Year', 'RS Fr', 'RS So', 'RS Jr', 'RS Sr'];\n1164\t    const found = [...new Set(allPlayers.map(p => p.class_year).filter(Boolean))];\n1165\t    found.sort((a, b) => {\n1166\t        const ai = yearOrder.indexOf(a), bi = yearOrder.indexOf(b);\n1167\t        if (ai !== -1 && bi !== -1) return ai - bi;\n1168\t        if (ai !== -1) return -1;\n1169\t        if (bi !== -1) return 1;\n1170\t        return a.localeCompare(b);\n1171\t    });\n1172\t\n1173\t    const container = document.getElementById('classChips');\n1174\t    container.innerHTML = '';\n1175\t    activeClassYears.clear();\n1176\t\n1177\t    found.forEach(yr => {\n1178\t        const chip = document.createElement('div');\n1179\t        chip.className = 'pos-chip';\n1180\t        chip.textContent = yr;\n1181\t        chip.addEventListener('click', () => {\n1182\t            if (activeClassYears.has(yr)) { activeClassYears.delete(yr); chip.classList.remove('active'); }\n1183\t            else                          { activeClassYears.add(yr);    chip.classList.add('active'); }\n1184\t            applyFilters();\n1185\t        });\n1186\t        container.appendChild(chip);\n1187\t    });\n1188\t}\n1189\t\n1190\t// ── Filter + render ───────────────────────────────────────────────────────\n1191\tfunction isFiltered() {\n1192\t    if (document.getElementById('searchBox').value.trim()) return true;\n1193\t    if (activePositions.size > 0 || activeClassYears.size > 0) return true;\n1194\t    for (const def of getStatDefs()) {\n1195\t        const s = sliderState[def.key];\n1196\t        if (s && (s.curMin !== s.dataMin || s.curMax !== s.dataMax)) return true;\n1197\t    }\n1198\t    return false;\n1199\t}\n1200\t\n1201\tasync function applyFilters() {\n1202\t    allPlayers = [];\n1203\t    serverOffset = 0;\n1204\t    hasMoreData = true;\n1205\t    await fetchBatch();\n1206\t    filteredPlayers = [...allPlayers];\n1207\t    currentPage = 1;\n1208\t    const filtered = isFiltered();\n1209\t    const displayCount = filtered ? filteredPlayers.length : (totalSeasonCount || filteredPlayers.length);\n1210\t    const suffix = filtered && hasMoreData ? '+' : '';\n1211\t    document.getElementById('resultsCount').textContent =