Ids.length > 0 && pageIds.every(id => selectedPlayerIds.has(id));\n1294\t    const selectAllCb = document.getElementById('selectAllCb');\n1295\t    if (selectAllCb) selectAllCb.checked = allChecked;\n1296\t\n1297\t    players.forEach((p, i) => {\n1298\t        const checked = selectedPlayerIds.has(p.player_id);\n1299\t        const tr = document.createElement('tr');\n1300\t        tr.addEventListener('click', () => window.location.href = `/player.html?id=${p.player_id}`);\n1301\t        const varCells = cols.map(c => `<td data-col=\"${c.col}\">${fmtCol(c, p[c.col])}</td>`).join('');\n1302\t        tr.innerHTML = `\n1303\t            <td class=\"cb-col\" onclick=\"event.stopPropagation()\">\n1304\t                <input type=\"checkbox\" data-id=\"${p.player_id}\" ${checked ? 'checked' : ''}>\n1305\t            </td>\n1306\t            <td style=\"color:#ccc;font-size:.88em\">${offset + i + 1}</td>\n1307\t            <td class=\"sim-cell\" onclick=\"event.stopPropagation();applyPlayerFilters(${p.player_id})\">≈</td>\n1308\t            <td data-col=\"full_name\"><span class=\"player-name\">${p.full_name}</span></td>\n1309\t            <td data-col=\"team\">${p.team || '-'}</td>\n1310\t            <td data-col=\"final_rating\" class=\"rating-cell\">${fmt(p.final_rating)}</td>\n1311\t            <td data-col=\"position\">${p.position || '-'}</td>\n1312\t            <td data-col=\"class_year\" style=\"color:#aaa\">${p.class_year || '-'}</td>\n1313\t            <td data-col=\"age\" style=\"color:#aaa\">${p.age ?? '-'}</td>\n1314\t            <td data-col=\"height_in\" style=\"color:#aaa\">${p.height || '-'}</td>\n1315\t            <td data-col=\"weight\" style=\"color:#aaa\">${p.weight ?? '-'}</td>\n1316\t            <td data-col=\"gp\">${p.gp ?? '-'}</td>\n1317\t            ${varCells}\n1318\t        `;\n1319\t        // Checkbox change handler — store as string to match allPlayers player_id type\n1320\t        tr.querySelector('input[type=checkbox]').addEventListener('c