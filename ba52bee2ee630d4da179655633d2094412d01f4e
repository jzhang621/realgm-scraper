          "text": "1\t\"\"\"\n2\tFastAPI Backend for NCAA Basketball Stats\n3\t\"\"\"\n4\tfrom fastapi import FastAPI, HTTPException, Query\n5\tfrom fastapi.middleware.cors import CORSMiddleware\n6\tfrom fastapi.middleware.gzip import GZipMiddleware\n7\tfrom fastapi.responses import JSONResponse\n8\tfrom fastapi.staticfiles import StaticFiles\n9\tfrom typing import List, Optional\n10\tfrom pydantic import BaseModel\n11\tfrom sqlalchemy import create_engine, text\n12\tfrom sqlalchemy.pool import QueuePool\n13\timport os\n14\timport time\n15\tfrom decimal import Decimal\n16\tfrom datetime import datetime, date\n17\t\n18\t# Database connection\n19\tDATABASE_URL = os.getenv('DATABASE_URL', 'postgresql://localhost:5432/ncaa_basketball')\n20\tengine = create_engine(\n21\t    DATABASE_URL,\n22\t    poolclass=QueuePool,\n23\t    pool_size=5,\n24\t    max_overflow=10\n25\t)\n26\t\n27\tapp = FastAPI(\n28\t    title=\"NCAA Basketball Stats API\",\n29\t    description=\"API for NCAA D1 Basketball player statistics and ratings\",\n30\t    version=\"1.0.0\"\n31\t)\n32\t\n33\t# CORS middleware\n34\tapp.add_middleware(\n35\t    CORSMiddleware,\n36\t    allow_origins=[\"*\"],  # In production, replace with specific domains\n37\t    allow_credentials=True,\n38\t    allow_methods=[\"*\"],\n39\t    allow_headers=[\"*\"],\n40\t)\n41\t\n42\t# Gzip compression — compresses large JSON responses ~70%\n43\tapp.add_middleware(GZipMiddleware, minimum_size=1000)\n44\t\n45\t# Helper function to convert rows to dict, normalizing Decimal/date types inline\n46\tdef rows_to_dict(rows, result):\n47\t    \"\"\"Convert database rows to list of dicts with JSON-safe types\"\"\"\n48\t    columns = list(result.keys())\n49\t    out = []\n50\t    for row in rows:\n51\t        d = {}\n52\t        for k, v in zip(columns, row):\n53\t            if isinstance(v, Decimal):\n54\t                d[k] = float(v)\n55\t            elif isinstance(v, (datetime, date)):\n56\t                d[k] = v.isoformat()\n57\t            else:\n58\t                d[k] = v\n59\t        out.append(d)\n60\t    return out\n61\t\n62\t\n63\t@app.get(\"/api/ratings/{season}\")\n64\tdef get_ratings(\n65\t    season: str,\n66\t    position: Optional[str] = None,\n67\t    team: Optional[str] = None,\n68\t    min_rating: Optional[float] = None,\n69\t    two_way: Optional[str] = None,\n70\t    limit: int = Query(100, le=15000),\n71\t    offset: int = 0\n72\t):\n73\t    \"\"\"\n74\t    Get player ratings for a season with optional filters\n75\t\n76\t    - **season**: \"2024-25\" or \"2025-26\"\n77\t    - **position**: Filter by position\n78\t    - **team**: Filter by team\n79\t    - **min_rating**: Minimum rating threshold\n80\t    - **two_way**: \"Y\" for two-way players only\n81\t    - **limit**: Max results (default 100, max 500)\n82\t    - **offset**: Pagination offset\n83\t    \"\"\"\n84\t    with engine.connect() as conn:\n85\t        query = \"\"\"\n86\t            SELECT *\n87\t            FROM player_ratings\n88\t            WHERE season = :season\n89\t        \"\"\"\n90\t        params = {'season': season}\n91\t\n92\t        if position:\n93\t            query += \" AND position = :position\"\n94\t            params['position'] = position\n95\t\n96\t        if team:\n97\t            query += \" AND team = :team\"\n98\t            params['team'] = team\n99\t\n100\t        if min_rating:\n101\t            query += \" AND final_rating >= :min_rating\"\n102\t            params['min_rating'] = min_rating\n103\t\n104\t        if two_way == 'Y':\n105\t            query += \" AND two_way = 'Y'\"\n106\t\n107\t        query += \" ORDER BY final_rating DESC LIMIT :limit OFFSET :offset\"\n108\t        params['limit'] = limit\n109\t        params['offset'] = offset\n110\t\n111\t        result = conn.execute(text(query), params)\n112\t        rows = result.fetchall()\n113\t\n114\t        data = rows_to_dict(rows, result)\n115\t\n116\t        return {\n117\t            \"season\": season,\n118\t            \"count\": len(data),\n119\t            \"data\": data\n120\t        }\n121\t\n122\t@app.get(\"/api/player/{player_id}\")\n123\tdef get_player(player_id: str):\n124\t    \"\"\"Get complete player information\"\"\"\n125\t    with engine.connect() as conn:\n126\t        # Get player bio\n127\t        result = conn.execute(\n128\t            text(\"SELECT * FROM players WHERE player_id = :player_id\"),\n129\t            {'player_id': player_id}\n130\t        )\n131\t        player = result.fetchone()\n132\t\n133\t        if not player:\n134\t            raise HTTPException(status_code=404, detail=\"Player not found\")\n135\t\n136\t        player_dict = dict(zip(result.keys(), player))\n137\t\n138\t        # Get all ratings\n139\t        result = conn.execute(\n140\t            text(\"\"\"\n141\t                SELECT * FROM player_ratings\n142\t                WHERE player_id = :player_id\n143\t                ORDER BY season DESC\n144\t            \"\"\"),\n145\t            {'player_id': player_id}\n146\t        )\n147\t        ratings = rows_to_dict(result.fetchall(), result)\n148\t\n149\t        return {\"player\": player_dict, \"ratings\": ratings}\n150\t\n151\t@app.get(\"/api/stats/{player_id}/{season}\")\n152\tdef get_player_stats(player_id: str, season: str):\n153\t    \"\"\"Get all stats for a player in a specific season\"\"\"\n154\t    with engine.connect() as conn:\n155\t        # Per game stats\n156\t        result = conn.execute(\n157\t            text(\"\"\"\n158\t                SELECT * FROM player_stats_pergame\n159\t                WHERE player_id = :player_id AND season = :season\n160\t            \"\"\"),\n161\t            {'player_id': player_id, 'season': season}\n162\t        )\n163\t        pergame = rows_to_dict(result.fetchall(), result)\n164\t\n165\t        # Advanced stats\n166\t        result = conn.execute(\n167\t            text(\"\"\"\n168\t                SELECT * FROM player_stats_advanced\n169\t                WHERE player_id = :player_id AND season = :season\n170\t            \"\"\"),\n171\t            {'player_id': player_id, 'season': season}\n172\t        )\n173\t        advanced = rows_to_dict(result.fetchall(), result)\n174\t\n175\t        # Misc stats\n176\t        result = conn.execute(\n177\t            text(\"\"\"\n178\t                SELECT * FROM player_stats_misc\n179\t                WHERE player_id = :player_id AND season = :season\n180\t            \"\"\"),\n181\t            {'player_id': player_id, 'season': season}\n182\t        )\n183\t        misc = rows_to_dict(result.fetchall(), result)\n184\t\n185\t        # Rating\n186\t        result = conn.execute(\n187\t            text(\"\"\"\n188\t                SELECT * FROM player_ratings\n189\t                WHERE player_id = :player_id AND season = :season\n190\t            \"\"\"),\n191\t            {'player_id': player_id, 'season': season}\n192\t        )\n193\t        rating = rows_to_dict(result.fetchall(), result)\n194\t\n195\t        if not pergame and not rating:\n196\t            raise HTTPException(status_code=404, detail=\"Stats not found for this player/season\")\n197\t\n198\t        return {\n199\t            \"player_id\": player_id,\n200\t            \"season\": season,\n201\t            \"pergame\": pergame[0] if pergame else None,\n202\t            \"advanced\": advanced[0] if advanced else None,\n203\t            \"misc\": misc[0] if misc else None,\n204\t            \"rating\": rating[0] if rating else None\n205\t        }\n206\t\n207\t@app.get(\"/api/search\")\n208\tdef search_players(\n209\t    q: str = Query(..., min_length=2),\n210\t    season: Optional[str] = None,\n211\t    limit: int = 20\n212\t):\n213\t    \"\"\"\n214\t    Search players by name\n215\t\n216\t    - **q**: Search query (min 2 characters)\n217\t    - **season**: Optional season filter\n218\t    - **limit**: Max results (default 20)\n219\t    \"\"\"\n220\t    with engine.connect() as conn:\n221\t        if season:\n222\t            query = \"\"\"\n223\t                SELECT DISTINCT\n224\t                    p.player_id,\n225\t                    p.full_name,\n226\t                    pr.team,\n227\t                    pr.position,\n228\t                    pr.final_rating\n229\t                FROM players p\n230\t                JOIN player_ratings pr ON p.player_id = pr.player_id\n231\t                WHERE LOWER(p.full_name) LIKE LOWER(:query)\n232\t                  AND pr.season = :season\n233\t                ORDER BY pr.final_rating DESC\n234\t                LIMIT :limit\n235\t            \"\"\"\n236\t            params = {'query': f'%{q}%', 'season': season, 'limit': limit}\n237\t        else:\n238\t            query = \"\"\"\n239\t                SELECT player_id, full_name, position\n240\t                FROM players\n241\t                WHERE LOWER(full_name) LIKE LOWER(:query)\n242\t                LIMIT :limit\n243\t            \"\"\"\n244\t            params = {'query': f'%{q}%', 'limit': limit}\n245\t\n246\t        result = conn.execute(text(query), params)\n247\t        rows = result.fetchall()\n248\t\n249\t        data = rows_to_dict(rows, result)\n250\t\n251\t        return {\"query\": q, \"count\": len(data), \"results\": data}\n252\t\n253\t@app.get(\"/api/compare\")\n254\tdef compare_players(\n255\t    player1: str,\n256\t    player2: str,\n257\t    season: str\n258\t):\n259\t    \"\"\"Compare two players for a specific season\"\"\"\n260\t    with engine.connect() as conn:\n261\t        query = text(\"\"\"\n262\t            SELECT *\n263\t            FROM player_ratings\n264\t            WHERE player_id IN (:p1, :p2) AND season = :season\n265\t        \"\"\")\n266\t\n267\t        result = conn.execute(query, {'p1': player1, 'p2': player2, 'season': season})\n268\t        ratings = rows_to_dict(result.fetchall(), result)\n269\t\n270\t        if len(ratings) < 2:\n271\t            raise HTTPException(\n272\t                status_code=404,\n273\t                detail=\"Could not find both players for this season\"\n274\t            )\n275\t\n276\t        return {\"season\": season, \"players\": ratings}\n277\t\n278\t@app.get(\"/api/teams/{season}\")\n279\tdef get_teams(season: str):\n280\t    \"\"\"Get all teams for a season\"\"\"\n281\t    with engine.connect() as conn:\n282\t        result = conn.execute(\n283\t            text(\"\"\"\n284\t                SELECT team_name, conference, wins, losses, total_games\n285\t                FROM teams\n286\t                WHERE season = :season\n287\t                ORDER BY conference, team_name\n288\t            \"\"\"),\n289\t            {'season': season}\n290\t        )\n291\t        teams = rows_to_dict(result.fetchall(), result)\n292\t\n293\t        return {\n294\t            \"season\": season,\n295\t            \"count\": len(teams),\n296\t            \"teams\": teams\n297\t        }\n298\t\n299\t@app.get(\"/api/players/{season}\")\n300\tdef get_players(\n301\t    season: str,\n302\t    position: Optional[str] = None,\n303\t    team: Optional[str] = None,\n304\t    min_rating: Optional[float] = None,\n305\t    two_way: Optional[str] = None,\n306\t    limit: int = Query(15000, le=15000),\n307\t    offset: int = 0\n308\t):\n309\t    \"\"\"Get wide player stats row from materialized view for a season\"\"\"\n310\t    with engine.connect() as conn:\n311\t        query = \"\"\"\n312\t            SELECT\n313\t                player_id, season, full_name, team, position, height, weight,\n314\t                hometown, age, pos_group, class_year, two_way,\n315\t                gp, min, pts, reb, ast, stl, blk, tov,\n316\t                fg_pct, fg3m, fg3a, fg3_pct, ft_pct, fgm, fga, ftm, fta,\n317\t                off_reb, def_reb,\n318\t                ts_pct, efg_pct, orb_pct, drb_pct, ast_pct, tov_pct,\n319\t                stl_pct, blk_pct, usg_pct, per, ortg, drtg, ppr, pps,\n320\t                dbl_dbl, tpl_dbl, ast_to_ratio, stl_to_ratio, win_pct,\n321\t                ws, ows, dws,\n322\t                t_min, t_pts, t_reb, t_ast, t_stl, t_blk, t_tov,\n323\t                t_fgm, t_fga, t_fg3m, t_fg3a, t_ftm, t_fta,\n324\t                min_per, pts_per, ast_per, reb_per, blk_per, stl_per,\n325\t                fgm_per, fgpct_per, p3pct_per, pm3_per, ftpct_per,\n326\t                base_rating, game_adj, final_rating,\n327\t                min_boost, three_boost, fg_boost, ast_boost, blk_boost,\n328\t                double_double_boost, triple_double_boost, free_throw_boost\n329\t            FROM player_season_stats\n330\t            WHERE season = :season\n331\t        \"\"\"\n332\t        params = {'season': season}\n333\t\n334\t        if position:\n335\t            query += \" AND position = :position\"\n336\t            params['position'] = position\n337\t\n338\t        if team:\n339\t            query += \" AND team = :team\"\n340\t            params['team'] = team\n341\t\n342\t        if min_rating:\n343\t            query += \" AND final_rating >= :min_rating\"\n344\t            params['min_rating'] = min_rating\n345\t\n346\t        if two_way == 'Y':\n347\t            query += \" AND two_way = 'Y'\"\n348\t\n349\t        query += \" ORDER BY final_rating DESC LIMIT :limit OFFSET :offset\"\n350\t        params['limit'] = limit\n351\t        params['offset'] = offset\n352\t\n353\t        result = conn.execute(text(query), params)\n354\t        data = rows_to_dict(result.fetchall(), result)\n355\t\n356\t        return {\"season\": season, \"count\": len(data), \"data\": data}\n357\t\n358\t\n359\t@app.get(\"/api/stats/leaderboard/{season}\")\n360\tdef get_leaderboard(\n361\t    season: str,\n362\t    stat: str = \"pts\",\n363\t    limit: int = 10\n364\t):\n365\t    \"\"\"\n366\t    Get top players by stat\n367\t\n368\t    - **season**: \"2024-25\" or \"2025-26\"\n369\t    - **stat**: Stat column (pts, reb, ast, etc.)\n370\t    - **limit**: Number of players\n371\t    \"\"\"\n372\t    # Whitelist allowed stat columns for security\n373\t    allowed_stats = ['pts', 'trb', 'ast', 'stl', 'blk', 'fg_pct', 'fg3_pct', 'ft_pct', 'min']\n374\t\n375\t    if stat not in allowed_stats:\n376\t        raise HTTPException(status_code=400, detail=f\"Invalid stat. Allowed: {allowed_stats}\")\n377\t\n378\t    with engine.connect() as conn:\n379\t        query = f\"\"\"\n380\t            SELECT\n381\t                p.player_id,\n382\t                p.full_name,\n383\t                pg.team,\n384\t                pg.{stat},\n385\t                pg.gp,\n386\t                pr.final_rating\n387\t            FROM player_stats_pergame pg\n388\t            JOIN players p ON pg.player_id = p.player_id\n389\t            LEFT JOIN player_ratings pr ON pg.player_id = pr.player_id AND pg.season = pr.season\n390\t            WHERE pg.season = :season\n391\t              AND pg.gp >= 10\n392\t            ORDER BY pg.{stat} DESC\n393\t            LIMIT :limit\n394\t        \"\"\"\n395\t\n396\t        result = conn.execute(text(query), {'season': season, 'limit': limit})\n397\t        leaders = rows_to_dict(result.fetchall(), result)\n398\t\n399\t        return {\"season\": season, \"stat\": stat, \"leaders\": leaders}\n400\t\n401\t@app.get(\"/api/similarity/{player_id}/{season}\")\n402\tdef get_similarity(player_id: str, season: str):\n403\t    with engine.connect() as conn:\n404\t        result = conn.execute(text(\"\"\"\n405\t            SELECT segment, rank, sim_player_id, sim_season, sim_name, sim_team, sim_pos, sim_rating, score\n406\t            FROM player_similarity\n407\t            WHERE player_id = :player_id AND season = :season\n408\t            ORDER BY segment, rank\n409\t        \"\"\"), {'player_id': player_id, 'season': season})\n410\t        rows = rows_to_dict(result.fetchall(), result)\n411\t\n412\t        segments = {}\n413\t        for r in rows:\n414\t            segments.setdefault(r['segment'], []).append(r)\n415\t\n416\t        return {'player_id': player_id, 'season': season, 'segments': segments}\n417\t\n418\t\n419\t@app.get(\"/api/profile/{player_id}\")\n420\tdef get_profile(player_id: str):\n421\t    \"\"\"Full player profile: bio + all seasons of stats + similarity\"\"\"\n422\t    with engine.connect() as conn:\n423\t        # Bio\n424\t        result = conn.execute(\n425\t            text(\"SELECT * FROM players WHERE player_id = :pid\"),\n426\t            {'pid': player_id}\n427\t        )\n428\t        row = result.fetchone()\n429\t        if not row:\n430\t            raise HTTPException(status_code=404, detail=\"Player not found\")\n431\t        bio = dict(zip(result.keys(), row))\n432\t\n433\t        # All seasons from each table\n434\t        def fetch_all(table):\n435\t            r = conn.execute(\n436\t                text(f\"SELECT * FROM {table} WHERE player_id = :pid ORDER BY season\"),\n437\t                {'pid': player_id}\n438\t            )\n439\t            return {row['season']: dict(row) for row in [dict(zip(r.keys(), row)) for row in r.fetchall()]}\n440\t\n441\t        pergame  = fetch_all('player_stats_pergame')\n442\t        advanced = fetch_all('player_stats_advanced')\n443\t        misc     = fetch_all('player_stats_misc')\n444\t\n445\t        r = conn.execute(\n446\t            text(\"SELECT * FROM player_ratings WHERE player_id = :pid ORDER BY season\"),\n447\t            {'pid': player_id}\n448\t        )\n449\t        ratings = rows_to_dict(r.fetchall(), r)\n450\t        ratings = {row['season']: row for row in ratings}\n451\t\n452\t        # Totals from materialized view\n453\t        r = conn.execute(\n454\t            text(\"\"\"SELECT season, t_min, t_pts, t_reb, t_ast, t_stl, t_blk, t_tov,\n455\t                           t_fgm, t_fga, t_fg3m, t_fg3a, t_ftm, t_fta\n456\t                    FROM player_season_stats WHERE player_id = :pid ORDER BY season\"\"\"),\n457\t            {'pid': player_id}\n458\t        )\n459\t        totals = {row['season']: dict(row) for row in [dict(zip(r.keys(), row)) for row in r.fetchall()]}\n460\t\n461\t        # Merge into season list\n462\t        all_seasons = sorted(set(list(pergame) + list(ratings)))\n463\t        seasons = []\n464\t        for s in all_seasons:\n465\t            seasons.append({\n466\t                'season':   s,\n467\t                'pergame':  pergame.get(s),\n468\t                'advanced': advanced.get(s),\n469\t                'misc':     misc.get(s),\n470\t                'totals':   totals.get(s),\n471\t                'rating':   ratings.get(s),\n472\t            })\n473\t\n474\t        # Similarity (2025-26 only)\n475\t        r = conn.execute(text(\"\"\"\n476\t            SELECT segment, rank, sim_player_id, sim_season, sim_name, sim_team, sim_pos, sim_rating, score\n477\t            FROM player_similarity\n478\t            WHERE player_id = :pid AND season = '2025-26'\n479\t            ORDER BY segment, rank\n480\t        \"\"\"), {'pid': player_id})\n481\t        sim_rows = [dict(zip(r.keys(), row)) for row in r.fetchall()]\n482\t        similarity = {}\n483\t        for row in sim_rows:\n484\t            similarity.setdefault(row['segment'], []).append(row)\n485\t\n486\t        return {'bio': bio, 'seasons': seasons, 'similarity': similarity}\n487\t\n488\t\n489\t@app.get(\"/api/hometown-coords\")\n490\tdef get_hometown_coords():\n491\t    with engine.connect() as conn:\n492\t        result = conn.execute(text(\"\"\"\n493\t            SELECT hometown, lat, lng FROM hometown_coords\n494\t            WHERE lat IS NOT NULL AND lng IS NOT NULL\n495\t        \"\"\"))\n496\t        rows = rows_to_dict(result.fetchall(), result)\n497\t        return {'coords': rows}\n498\t\n499\t\n500\t@app.get(\"/api/search\")\n501\tdef search_players(q: str = '', limit: int = 10):\n502\t    with engine.connect() as conn:\n503\t        result = conn.execute(text(\"\"\"\n504\t            SELECT DISTINCT player_id, full_name\n505\t            FROM player_similarity\n506\t            WHERE full_name ILIKE :q OR player_id = :pid\n507\t            LIMIT :limit\n508\t        \"\"\"), {'q': f'%{q}%', 'pid': q, 'limit': limit})\n509\t        rows = rows_to_dict(result.fetchall(), result)\n510\t\n511\t        # Also search by name in player_season_stats for 2025-26 top 100\n512\t        result2 = conn.execute(text(\"\"\"\n513\t            SELECT DISTINCT player_id, full_name\n514\t            FROM player_season_stats\n515\t            WHERE full_name ILIKE :q AND season = '2025-26'\n516\t            ORDER BY full_name\n517\t            LIMIT :limit\n518\t        \"\"\"), {'q': f'%{q}%', 'limit': limit})\n519\t        rows2 = rows_to_dict(result2.fetchall(), result2)\n520\t\n521\t        # Merge, deduplicate\n522\t        seen = set()\n523\t        merged = []\n524\t        for r in list(rows) + list(rows2):\n525\t            if r['player_id'] not in seen:\n526\t                seen.add(r['player_id'])\n527\t                merged.append(r)\n528\t\n529\t        return {'results': merged[:limit]}\n530\t\n531\t\n532\t# Serve frontend — must be mounted last so /api routes take priority\n533\timport os as _os\n534\t_static_dir = _os.path.dirname(__file__)\n535\tif _os.path.exists(_os.path.join(_static_dir, \"index.html\")):\n536\t    app.mount(\"/\", StaticFiles(directory=_static_dir, html=True), name=\"static\")\n537\t\n538\tif __name__ == \"__main__\":\n539\t    import uvicorn\n540\t    uvicorn.run(app, host=\"0.0.0.0\", port=8000)\n541\t",
