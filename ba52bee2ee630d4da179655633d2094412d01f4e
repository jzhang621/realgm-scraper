   const rows = simData.segments?.[seg] || [];\n387\t        renderSegment(seg, rows);\n388\t    });\n389\t}\n390\t\n391\tfunction renderPlayerCard(p) {\n392\t    if (!p) return;\n393\t    const card = document.getElementById('playerCard');\n394\t    card.classList.add('show');\n395\t\n396\t    document.getElementById('cardName').textContent = p.full_name;\n397\t    document.getElementById('cardMeta').textContent =\n398\t        [p.team, p.position, p.class_year, p.height, p.weight ? p.weight + ' lbs' : null, p.age ? 'Age ' + p.age : null]\n399\t        .filter(Boolean).join(' · ');\n400\t\n401\t    const stats = [\n402\t        ['Rating', p.final_rating?.toFixed(1)],\n403\t        ['PPG', p.pts?.toFixed(1)],\n404\t        ['RPG', p.reb?.toFixed(1)],\n405\t        ['APG', p.ast?.toFixed(1)],\n406\t        ['SPG', p.stl?.toFixed(1)],\n407\t        ['BPG', p.blk?.toFixed(1)],\n408\t        ['MIN', p.min?.toFixed(1)],\n409\t        ['3PA', p.fg3a?.toFixed(1)],\n410\t        ['3P%', p.fg3_pct != null ? (p.fg3_pct * 100).toFixed(1) + '%' : null],\n411\t        ['FG%', p.fg_pct != null ? (p.fg_pct * 100).toFixed(1) + '%' : null],\n412\t        ['USG%', p.usg_pct != null ? Number(p.usg_pct).toFixed(1) + '%' : null],\n413\t        ['TS%', p.ts_pct != null ? (p.ts_pct * 100).toFixed(1) + '%' : null],\n414\t    ];\n415\t\n416\t    document.getElementById('cardStats').innerHTML = stats\n417\t        .filter(([, v]) => v != null)\n418\t        .map(([l, v]) => `<div class=\"stat-pill\">${l} <span>${v}</span></div>`)\n419\t        .join('');\n420\t}\n421\t\n422\tfunction renderSegment(seg, rows) {\n423\t    const el = document.getElementById(`list-${seg}`);\n424\t    if (!rows.length) {\n425\t        el.innerHTML = '<div class=\"empty-state\">No similar players found</div>';\n426\t        return;\n427\t    }\n428\t    el.innerHTML = rows.map(r => `\n429\t        <div class=\"sim-row\">\n430\t            <div class=\"sim-rank\">${r.rank}</div>\n431\t            <div class=\"sim-info\">\n432\t                <div class=\"sim-name\">${r.sim_name}</div>\n433\t                <div class=\"sim-meta\">${r.sim_team} · ${r.sim_pos} · ${r.sim_season}</div>\n434\t            </div>\n435\t            <div class=\"sim-rating\">${Number(r.sim_rating).toFixed(1)}</div>\n436\t            <div class=\"sim-score\">${Number(r.score).toFixed(3)}</div>\n437\t        </div>\n438\t    `).join('');\n439\t}\n440\t</script>\n441\t</body>\n442\t</html>\n443\t",
