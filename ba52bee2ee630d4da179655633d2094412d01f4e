nd: linear-gradient(135deg, #667eea, #764ba2);\n180\t            color: white;\n181\t        }\n182\t        th {\n183\t            padding: 9px 10px;\n184\t            text-align: right;\n185\t            font-weight: 600;\n186\t            white-space: nowrap;\n187\t            cursor: pointer;\n188\t            user-select: none;\n189\t        }\n190\t        th:first-child, th:nth-child(2), th:nth-child(3), th:nth-child(4) { text-align: left; }\n191\t\n192\t        tbody tr {\n193\t            border-bottom: 1px solid #f5f5f5;\n194\t            cursor: pointer;\n195\t            transition: background 0.1s;\n196\t        }\n197\t        tbody tr:hover { background: #f7f8ff; }\n198\t        tbody tr.selected { background: #ede9fe; }\n199\t\n200\t        td {\n201\t            padding: 9px 10px;\n202\t            text-align: right;\n203\t            white-space: nowrap;\n204\t            color: #444;\n205\t        }\n206\t        td:first-child, td:nth-child(2), td:nth-child(3), td:nth-child(4) { text-align: left; }\n207\t\n208\t        .season-cell { font-weight: 700; color: #333; }\n209\t        .team-cell { font-weight: 600; color: #667eea; }\n210\t        .level-badge {\n211\t            font-size: 9px;\n212\t            font-weight: 700;\n213\t            padding: 1px 5px;\n214\t            border-radius: 3px;\n215\t            background: #fef3c7;\n216\t            color: #92400e;\n217\t            margin-left: 4px;\n218\t            vertical-align: middle;\n219\t        }\n220\t        .rating-cell { font-weight: 700; color: #10b981; }\n221\t        .null-cell { color: #ddd; }\n222\t\n223\t        /* ── Bottom panels ── */\n224\t        .bottom-panels {\n225\t            display: grid;\n226\t            grid-template-columns: 380px 1fr;\n227\t            gap: 14px;\n228\t        }\n229\t\n230\t        /* ── Rating breakdown ── */\n231\t        .breakdown-header {\n232\t            padding: 18px 20px 12px;\n233\t            border-bottom: 1px solid #f0f0f0;\n234\t        }\n235\t        .breakdown-season {\n236\t            font-size: 11px;\n237\t            color: #aaa;\n238\t            font-weight: 600;\n239\t            margin-top: 2px;\n240\t        }\n241\t\n242\t        .breakdown-body { padding: 16px 20px; }\n243\t\n244\t        .rating-final {\n245\t            font-size: 2.5em;\n246\t            font-weight: 800;\n247\t            color: #10b981;\n248\t            line-height: 1;\n249\t            margin-bottom: 16px;\n250\t        }\n251\t\n252\t        .breakdown-row {\n253\t            display: flex;\n254\t            justify-content: space-between;\n255\t            align-items: center;\n256\t            padding: 5px 0;\n257\t            border-bottom: 1px solid #f8f8f8;\n258\t            font-size: 12.5px;\n259\t        }\n260\t        .breakdown-row:last-child { border-bottom: none; }\n261\t        .breakdown-row-label { color: #666; }\n262\t        .breakdown-row-val {\n263\t            font-weight: 700;\n264\t            font-variant-numeric: tabular-nums;\n265\t        }\n266\t        .breakdown-row-val.positive { color: #10b981; }\n267\t        .breakdown-row-val.negative { color: #ef4444; }\n268\t        .breakdown-row-val.base { color: #333; }\n269\t\n270\t        .percentile-section { margin-top: 16px; }\n271\t        .percentile-title {\n272\t            font-size: 10px;\n273\t            font-weight: 700;\n274\t            color: #aaa;\n275\t            text-transform: uppercase;\n276\t            letter-spacing: 0.5px;\n277\t            margin-bottom: 10px;\n278\t        }\n279\t        .pct-row {\n280\t            display: flex;\n281\t            align-items: center;\n282\t            gap: 8px;\n283\t            margin-bottom: 6px;\n284\t            font-size: 11.5px;\n285\t        }\n286\t        .pct-label { width: 50px; color: #666; font-weight: 600; flex-shrink: 0; }\n287\t        .pct-bar-wrap { flex: 1; background: #f0f0f0; border-radius: 3px; height: 6px; }\n288\t        .pct-bar { height: 6px; border-radius: 3px; background: linear-gradient(90deg, #667eea, #764ba2); }\n289\t        .pct-val { width: 32px; text-align: right; color: #667eea; font-weight: 700; font-size: 11px; }\n290\t\n291\t        /* ── Similar players ── */\n292\t        .sim-tabs {\n293\t            display: flex;\n294\t            gap: 0;\n295\t            border-bottom: 1px solid #f0f0f0;\n296\t            padding: 0 20px;\n297\t            margin-top: 4px;\n298\t        }\n299\t        .sim-tab {\n300\t            padding: 10px 14px;\n301\t            font-size: 12px;\n302\t            font-weight: 600;\n303\t            color: #aaa;\n304\t            cursor: pointer;\n305\t            border-bottom: 2px solid transparent;\n306\t            transition: all 0.12s;\n307\t            white-space: nowrap;\n308\t        }\n309\t        .sim-tab.active { color: #667eea; border-bottom-color: #667eea; }\n310\t\n311\t        .sim-list { padding: 12px 20px; }\n312\t\n313\t        .sim-row {\n314\t            display: flex;\n315\t            align-items: center;\n316\t            gap: 10px;\n317\t            padding: 8px 0;\n318\t            border-bottom: 1px solid #f8f8f8;\n319\t            cursor: pointer;\n320\t            transition: background 0.1s;\n321\t            border-radius: 6px;\n322\t        }\n323\t        .sim-row:last-child { border-bottom: none; }\n324\t        .sim-row:hover { background: #f7f8ff; padding-left: 6px; }\n325\t\n326\t        .sim-rank {\n327\t            width: 20px;\n328\t            font-size: 11px;\n329\t            color: #ccc;\n330\t            font-weight: 700;\n331\t            flex-shrink: 0;\n332\t            text-align: center;\n333\t        }\n334\t        .sim-info { flex: 1; min-width: 0; }\n335\t        .sim-name {\n336\t            font-weight: 700;\n337\t            color: #333;\n338\t            font-size: 13px;\n339\t            white-space: nowrap;\n340\t            overflow: hidden;\n341\t            text-overflow: ellipsis;\n342\t        }\n343\t        .sim-meta { font-size: 11px; color: #aaa; margin-top: 1px; }\n344\t        .sim-rating {\n345\t            font-weight: 700;\n346\t            color: #10b981;\n347\t            font-size: 13px;\n348\t            flex-shrink: 0;\n349\t        }\n350\t        .sim-score {\n351\t            font-size: 10px;\n352\t            color: #ccc;\n353\t            flex-shrink: 0;\n354\t            width: 36px;\n355\t            text-align: right;\n356\t        }\n357\t\n358\t        .sim-unavailable {\n359\t            padding: 24px 20px;\n360\t            text-align: center;\n361\t            color: #bbb;\n362\t            font-size: 13px;\n363\t        }\n364\t\n365\t        .loading { padding: 60px; text-align: center; color: #aaa; font-size: 14px; }\n366\t    </style>\n367\t</head>\n368\t<body>\n369\t\n370\t<!-- Nav -->\n371\t<div class=\"nav-tabs\">\n372\t    <div class=\"nav-brand\">NIL <span>PRO</span></div>\n373\t    <a href=\"/index.html\" class=\"nav-tab\">Rankings</a>\n374\t    <a href=\"/similarity.html\" class=\"nav-tab\">Similar Players</a>\n375\t</div>\n376\t\n377\t<div class=\"profile-page\" id=\"profilePage\">\n378\t    <div class=\"loading\">Loading player profile…</div>\n379\t</div>\n380\t\n381\t<script>\n382\tconst API_BASE = (location.port === '3000' || location.port === '5500' || location.port === '5173')\n383\t    ? 'http://localhost:8000/api'\n384\t    : '/api';\n385\t\n386\tconst params = new URLSearchParams(location.search);\n387\tconst PLAYER_ID = params.get('id');\n388\t\n389\tlet profileData = null;\n390\tlet selectedSeason = null;\n391\tlet careerMode = 'pergame';  // 'pergame' | 'totals' | 'advanced'\n392\tlet simSegment = 'production';\n393\t\n394\t// ── Boot ──────────────────────────────────────────────────────────────────\n395\tasync function init() {\n396\t    if (!PLAYER_ID) {\n397\t        document.getElementById('profilePage').innerHTML = '<div class=\"loading\">No player ID specified.</div>';\n398\t        return;\n399\t    }\n400\t\n401\t    const res = await fetch(`${API_BASE}/profile/${PLAYER_ID}`);\n402\t    if (!res.ok) {\n403\t        document.getElementById('profilePage').innerHTML = '<div class=\"loading\">Player not found.</div>';\n404\t        return;\n405\t    }\n406\t\n407\t    profileData = await res.json();\n408\t\n409\t    // Default selected season = most recent with a rating\n410\t    const rated = profileData.seasons.filter(s => s.rating);\n411\t    selectedSeason = rated.length ? rated[rated.length - 1].season : profileData.seasons[profileData.seasons.length - 1]?.season;\n412\t\n413\t    // Set page title\n414\t    document.title = `${profileData.bio.full_name} | NIL PRO`;\n415\t\n416\t    render();\n417\t}\n418\t\n419\t// ── Render ────────────────────────────────────────────────────────────────\n420\tfunction render() {\n421\t    const { bio, seasons, similarity } = profileData;\n422\t    const currentRating = seasons.find(s => s.season === selectedSeason)?.rating;\n423\t\n424\t    document.getElementById('profilePage').innerHTML = `\n425\t        ${renderHeader(bio, seasons, currentRating)}\n426\t        ${renderCareerSection(seasons)}\n427\t        <div class=\"bottom-panels\">\n428\t            ${renderBreakdown(currentRating, selectedSeason)}\n429\t            ${renderSimilarity(similarity)}\n430\t        </div>\n431\t    `;\n432\t\n433\t    attachCareerListeners(seasons);\n434\t    attachSimListeners();\n435\t}\n436\t\n437\tfunction renderHeader(bio, seasons, currentRating) {\n438\t    const ratedSeasons = seasons.filter(s => s.rating);\n439\t    const pills = [\n440\t        bio.position       ? `<span class=\"meta-pill\">${bio.position}</span>` : '',\n441\t        currentRating?.team ? `<span class=\"meta-pill team\">${currentRating.team}</span>` : '',\n442\t        seasons.find(s=>s.pergame)?.pergame?.class_year ? `<span class=\"meta-pill\">${seasons.find(s=>s.season===selectedSeason)?.pergame?.class_year || ''}</span>` : '',\n443\t        bio.height_ft      ? `<span class=\"meta-pill\">${bio.height_ft}</span>` : '',\n444\t        bio.weight_lbs     ? `<span class=\"meta-pill\">${bio.weight_lbs} lbs</span>` : '',\n445\t        bio.hometown       ? `<span class=\"meta-pill\">${bio.hometown}</span>` : '',\n446\t        bio.birthdate      ? `<span class=\"meta-pill\">b. ${bio.birthdate}</span>` : '',\n447\t        currentRating?.two_way === 'Y' ? `<span class=\"meta-pill two-way\">Two-Way</span>` : '',\n448\t    ].filter(Boolean).join('');\n449\t\n450\t    const sparkBars = renderSparkline(ratedSeasons);\n451\t\n452\t    return `\n453\t        <div class=\"card\">\n454\t            <div class=\"profile-header\">\n455\t                <div>\n456\t                    <div class=\"profile-name\">${bio.full_name}</div>\n457\t                    <div class=\"profile-meta\">${pills}</div>\n458\t                </div>\n459\t                ${currentRating ? `\n460\t                <div class=\"rating-badge\">\n461\t                    <div class=\"rating-num\">${Number(currentRating.final_rating).toFixed(1)}</div>\n462\t                    <div class=\"rating-label\">${selectedSeason} Rating</div>\n463\t                </div>` : ''}\n464\t            </div>\n465\t            ${ratedSeasons.length > 0 ? `\n466\t            <div class=\"sparkline-section\">\n467\t                <div class=\"sparkline-label\">Rating Trajectory</div>\n468\t                ${renderSparkline(ratedSeasons)}\n469\t            </div>` : ''}\n470\t        </div>\n471\t    `;\n472\t}\n473\t\n474\tfunction renderSparkline(ratedSeasons) {\n475\t    const W = 600, H = 90;\n476\t    const PAD = { top: 24, bottom: 28, left: 20, right: 20 };\n477\t    const innerW = W - PAD.left - PAD.right;\n478\t    const innerH = H - PAD.top - PAD.bottom;\n479\t\n480\t    const ratings = ratedSeasons.map(s => Number(s.rating.final_rating));\n481\t    const minR = Math.min(...ratings);\n482\t    const maxR = Math.max(...ratings);\n483\t    const span = maxR - minR || 10;\n484\t\n485\t    const n = ratedSeasons.length;\n486\t    const points = ratedSeasons.map((s, i) => {\n487\t        const x = PAD.left + (n === 1 ? innerW / 2 : (i / (n - 1)) * innerW);\n488\t        const y = PAD.top + innerH - ((Number(s.rating.final_rating) - minR) / span) * innerH;\n489\t        return { x, y, s };\n490\t    });\n491\t\n492\t    const polyline = points.map(p => `${p.x},${p.y}`).join(' ');\n493\t\n494\t    // Gradient area fill\n495\t    const areaPoints = [\n496\t        `${points[0].x},${PAD.top + innerH}`,\n497\t        ...points.map(p => `${p.x},${p.y}`),\n498\t        `${points[points.length-1].x},${PAD.top + innerH}`\n499\t    ].join(' ');\n500\t\n501\t    const dots = points.map(p => {\n502\t        const r = Number(p.s.rating.final_rating);\n503\t        const active = p.s.season === selectedSeason;\n504\t        const fill = active ? '#667eea' : '#a5b4fc';\n505\t        const stroke = active ? '#fff' : '#fff';\n506\t        const rAttr = active ? 6 : 4;\n507\t        return `\n508\t            <g class=\"spark-point\" onclick=\"selectSeason('${p.s.season}')\" data-season=\"${p.s.season}\">\n509\t                <circle cx=\"${p.x}\" cy=\"${p.y}\" r=\"${rAttr}\" fill=\"${fill}\" stroke=\"${stroke}\" stroke-width=\"2\"/>\n510\t                <text x=\"${p.x}\" y=\"${p.y - 10}\" text-anchor=\"middle\"\n511\t                    font-size=\"10\" font-weight=\"${active ? 700 : 600}\"\n512\t                    fill=\"${active ? '#667eea' : '#999'}\">${r.toFixed(1)}</text>\n513\t                <text x=\"${p.x}\" y=\"${PAD.top + innerH + 14}\" text-anchor=\"middle\"\n514\t                    font-size=\"9\" font-weight=\"600\" fill=\"${active ? '#667eea' : '#bbb'}\">${p.s.season.slice(2)}</text>\n515\t                <rect x=\"${p.x - 20}\" y=\"${p.y - 20}\" width=\"40\" height=\"36\" fill=\"transparent\"/>\n516\t            </g>`;\n517\t    }).join('');\n518\t\n519\t    return `\n520\t        <svg class=\"sparkline-svg\" viewBox=\"0 0 $