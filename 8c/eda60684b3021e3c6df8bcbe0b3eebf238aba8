- block percentage\n100\t    usg_pct DECIMAL(6,2),  -- usage percentage\n101\t    total_s_pct DECIMAL(7,4),\n102\t    ppr DECIMAL(5,2),\n103\t    pps DECIMAL(5,2),\n104\t    ortg DECIMAL(6,2),  -- offensive rating\n105\t    drtg DECIMAL(6,2),  -- defensive rating\n106\t    per DECIMAL(6,2),  -- player efficiency rating\n107\t    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n108\t    UNIQUE(player_id, season, team, stat_type)\n109\t);\n110\t\n111\tCREATE INDEX idx_advanced_player ON player_stats_advanced(player_id);\n112\tCREATE INDEX idx_advanced_season ON player_stats_advanced(season);\n113\tCREATE INDEX idx_advanced_per ON player_stats_advanced(per DESC);\n114\t\n115\t-- Player stats - misc\n116\tCREATE TABLE player_stats_misc (\n117\t    id SERIAL PRIMARY KEY,\n118\t    player_id VARCHAR(20) REFERENCES players(player_id) ON DELETE CASCADE,\n119\t    season VARCHAR(10) NOT NULL,\n120\t    age INTEGER,\n121\t    level VARCHAR(50),\n122\t    league_name VARCHAR(100),\n123\t    team VARCHAR(100),\n124\t    class_year VARCHAR(50),\n125\t    stat_type VARCHAR(50),\n126\t    gp INTEGER,\n127\t    gs INTEGER,\n128\t    dbl_dbl INTEGER,  -- double-doubles\n129\t    tpl_dbl INTEGER,  -- triple-doubles\n130\t    pts_40 INTEGER,\n131\t    reb_20 INTEGER,\n132\t    ast_20 INTEGER,\n133\t    techs INTEGER,\n134\t    hob INTEGER,\n135\t    ast_to_ratio DECIMAL(5,2),\n136\t    stl_to_ratio DECIMAL(5,2),\n137\t    ft_per_fga DECIMAL(6,4),\n138\t    wins INTEGER,\n139\t    losses INTEGER,\n140\t    win_pct DECIMAL(5,4),\n141\t    ows DECIMAL(5,2),  -- offensive win shares\n142\t    dws DECIMAL(5,2),  -- defensive win shares\n143\t    ws DECIMAL(5,2),  -- win shares\n144\t    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n145\t    UNIQUE(player_id, season, team, stat_type)\n146\t);\n147\t\n148\tCREATE INDEX idx_misc_player ON player_stats_misc(player_id);\n149\tCREATE INDEX idx_misc_season ON player_stats_misc(season);\n150\tCREATE INDEX idx_misc_dbl_dbl ON player_stats_misc(dbl_dbl DESC);\n151\t\n152\t-- Player ratings (calculated)\n153\tCREATE TABLE player_ratings (\n154\t    id SERIAL PRIMARY KEY,\n155\t    player_id VARCHAR(20) REFERENCES players(player_id) ON DELETE CASCADE,\n156\t    season VARCHAR(10) NOT NULL,\n157\t    full_name VARCHAR(255),\n158\t    team VARCHAR(100),\n159\t    position VARCHAR(50),\n160\t    height VARCHAR(10),\n161\t    weight INTEGER,\n162\t    hometown VARCHAR(255),\n163\t    gp INTEGER,\n164\t    minutes DECIMAL(5,2),\n165\t    pts DECIMAL(5,2),\n166\t    fg3m DECIMAL(5,2),\n167\t    fg3_pct DECIMAL(5,4),\n168\t    fgm DECIMAL(5,2),\n169\t    fg_pct DECIMAL(5,4),\n170\t    ft_pct DECIMAL(5,4),\n171\t    ast DECIMAL(5,2),\n172\t    reb DECIMAL(5,2),\n173\t    blk DECIMAL(5,2),\n174\t    stl DECIMAL(5,2),\n175\t    double_doubles INTEGER,\n176\t    triple_doubles INTEGER,\n177\t    -- Percentiles\n178\t    min_per INTEGER,\n179\t    pts_per INTEGER,\n180\t    pm3_per INTEGER,\n181\t    p3pct_per INTEGER,\n182\t    fgm_per INTEGER,\n183\t    fgpct_per INTEGER,\n184\t    ftpct_per INTEGER,\n185\t    ast_per INTEGER,\n186\t    reb_per INTEGER,\n187\t    blk_per INTEGER,\n188\t    stl_per INTEGER,\n189\t    -- Rating components\n190\t    base_rating DECIMAL(6,2),\n191\t    game_adj DECIMAL(6,2),\n192\t    min_boost DECIMAL(6,2),\n193\t    three_boost DECIMAL(6,2),\n194\t    fg_boost DECIMAL(6,2),\n195\t    ast_boost DECIMAL(6,2),\n196\t    blk_boost DECIMAL(6,2),\n197\t    double_double_boost DECIMAL(6,2),\n198\t    triple_double_boost DECIMAL(6,2),\n199\t    free_throw_boost DECIMAL(6,2),\n200\t    final_rating DECIMAL(6,2) NOT NULL,\n201\t    two_way CHAR(1),\n202\t    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n203\t    UNIQUE(player_id, season)\n204\t);\n205\t\n206\tCREATE INDEX idx_ratings_player ON player_ratings(player_id);\n207\tCREATE INDEX idx_ratings_season ON player_ratings(season);\n208\tCREATE INDEX idx_ratings_final ON player_ratings(final_rating DESC);\n209\tCREATE INDEX idx_ratings_team ON player_ratings(team);\n210\tCREATE INDEX idx_ratings_position ON player_ratings(position);\n211\tCREATE INDEX idx_ratings_season_rating ON player_ratings(season, final_rating DESC);\n212\tCREATE INDEX idx_ratings_two_way ON player_ratings(two_way);\n213\t\n214\t-- Create a view for easy querying of complete player data\n215\tCREATE OR REPLACE VIEW player_complete_stats AS\n216\tSELECT\n217\t    p.player_id,\n218\t    p.full_name,\n219\t    p.position,\n220\t    p.height_ft,\n221\t    p.weight_lbs,\n222\t    p.hometown,\n223\t    pg.season,\n224\t    pg.team,\n225\t    pg.gp,\n226\t    pg.min,\n227\t    pg.pts,\n228\t    pg.trb,\n229\t    pg.ast,\n230\t    pg.stl,\n231\t    pg.blk,\n232\t    pg.fg_pct,\n233\t    pg.fg3_pct,\n234\t    pg.ft_pct,\n235\t    adv.per,\n236\t    adv.ts_pct,\n237\t    adv.usg_pct,\n238\t    misc.dbl_dbl,\n239\t    misc.tpl_dbl,\n240\t    pr.final_rating,\n241\t    pr.two_way\n242\tFROM players p\n243\tLEFT JOIN player_stats_pergame pg ON p.player_id = pg.player_id\n244\tLEFT JOIN player_stats_advanced adv ON p.player_id = adv.player_id AND pg.season = adv.season\n245\tLEFT JOIN player_stats_misc misc ON p.player_id = misc.player_id AND pg.season = misc.season\n246\tLEFT JOIN player_ratings pr ON p.player_id = pr.player_id AND pg.season = pr.season;\n247\t",
